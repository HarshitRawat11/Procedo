---
// Sticky translucent light navbar. Hairline border fades in on scroll; nav
// items have an animated orange underline; single orange CTA; accessible
// mobile menu.
import Container from './Container.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';
import { nav } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-cream/80 backdrop-blur-md transition-[border-color] duration-300"
>
  <Container class="flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <Logo />

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative px-3 py-2 text-sm font-medium transition-colors after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:rounded-full after:bg-brand-500 after:transition-transform after:duration-300 hover:text-navy-950 hover:after:scale-x-100',
              isActive(item.href)
                ? 'text-navy-950 after:scale-x-100'
                : 'text-navy-700 after:scale-x-0',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <Button href="/contact" chevron>Get in Touch</Button>
    </div>

    {
      /* Below `md` the full button above is hidden and the nav collapses, which
         used to leave EIGHT OF TEN PAGES with no visible way to make contact
         until the visitor scrolled — measured 2026-09-19, zero qualifying CTAs
         above the fold at 375px on every page except / and /404. The one in the
         mobile menu (further down this file) does not count: it is behind a tap.

         A phone visitor checking a vendor is the audience this site is written
         for, and the enquiry is the whole point of it, so the button is now
         always present and only the label shortens. `px-4 py-2` rather than the
         `md` size keeps logo + button + hamburger on one 375px line. */
    }
    <div class="md:hidden">
      <Button href="/contact" class="px-4 py-2">Contact</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="group -mr-2 inline-flex size-10 items-center justify-center rounded-lg text-navy-900 hover:bg-band md:hidden"
    >
      <Icon name="lucide:menu" class="size-6 group-aria-expanded:hidden" aria-hidden="true" />
      <Icon name="lucide:x" class="hidden size-6 group-aria-expanded:block" aria-hidden="true" />
      <span class="sr-only">Toggle menu</span>
    </button>
  </Container>

  <div id="mobile-menu" hidden class="border-t border-line bg-cream md:hidden">
    <Container class="py-4">
      <nav aria-label="Mobile" class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2.5 text-base font-medium transition-colors',
                isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-navy-800 hover:bg-band',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <Button href="/contact" class="mt-3 w-full" chevron>Get in Touch</Button>
      </nav>
    </Container>
  </div>
</header>

<script>
  // The router replaces the header on every navigation, so nothing here may
  // hold on to an element. The scroll handler re-queries, and the menu button
  // is handled by delegation from the document, which survives a swap.
  let header: HTMLElement | null = null;
  const onScroll = () => header?.classList.toggle('border-line', window.scrollY > 8);

  const sync = () => {
    header = document.getElementById('site-header');
    onScroll();
  };
  sync();
  document.addEventListener('astro:page-load', sync);
  window.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement | null)?.closest?.('#menu-toggle');
    if (!(toggle instanceof HTMLElement)) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    const menu = document.getElementById('mobile-menu');
    if (menu) menu.hidden = open;
  });
</script>
