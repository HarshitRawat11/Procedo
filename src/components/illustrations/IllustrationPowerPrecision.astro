---
/* Power & Precision Systems — a UPS feeding a battery bank and a cooling fan,
   with power flowing along the busbar above. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['ill', className]}
  viewBox="0 0 320 240"
  role="img"
  aria-labelledby="ill-pwr-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="ill-pwr-title">
    A UPS unit, a charged battery bank and a cooling fan standing side by side, linked by a
    busbar carrying power between them.
  </title>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- ground -->
    <ellipse cx="160" cy="198" rx="112" ry="5" fill="#F3F4F6" />
    <path d="M30 198 H290" stroke="#CBD5E1" stroke-width="2" />

    <!-- busbar -->
    <path d="M78 74 H244" stroke="#CBD5E1" stroke-width="2" />
    <path d="M78 74 V102 M160 74 V118 M244 74 V108" stroke="#CBD5E1" stroke-width="2" />
    <circle class="flow" cx="78" cy="74" r="3.5" fill="#F24E1E" />

    <!-- UPS -->
    <rect x="42" y="102" width="74" height="96" rx="6" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <rect x="52" y="112" width="54" height="26" rx="3" fill="#F3F4F6" />
    <rect x="59" y="119" width="32" height="12" rx="2" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="1.8" />
    <path d="M92 123 V127" stroke="#1B2A4A" stroke-width="2.5" />
    <g fill="#16A34A">
      <rect x="62" y="122" width="6" height="6" rx="1" />
      <rect x="71" y="122" width="6" height="6" rx="1" />
      <rect x="80" y="122" width="6" height="6" rx="1" />
    </g>
    <!-- bolt -->
    <path d="M84 148 L64 176 H76 L70 194 L94 164 H81 Z" fill="#F24E1E" />

    <!-- battery bank -->
    <rect x="130" y="118" width="60" height="80" rx="5" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <path d="M150 118 V198 M170 118 V198" stroke="#CBD5E1" stroke-width="2" />
    <g fill="#16A34A">
      <rect class="cell cell-1" x="136" y="160" width="8" height="30" rx="2" />
      <rect class="cell cell-2" x="156" y="152" width="8" height="38" rx="2" />
      <rect class="cell cell-3" x="176" y="166" width="8" height="24" rx="2" />
    </g>
    <path d="M130 138 H190" stroke="#CBD5E1" stroke-width="2" />

    <!-- cooling fan -->
    <rect x="204" y="108" width="74" height="90" rx="6" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <g transform="translate(241 148)">
      <circle r="28" fill="#F3F4F6" stroke="#1B2A4A" stroke-width="2" />
      <g class="blades" fill="#CBD5E1">
        <path d="M0 0 C-11 -14 -8 -25 0 -25 C8 -25 11 -14 0 0 Z" />
        <path d="M0 0 C-11 -14 -8 -25 0 -25 C8 -25 11 -14 0 0 Z" transform="rotate(90)" />
        <path d="M0 0 C-11 -14 -8 -25 0 -25 C8 -25 11 -14 0 0 Z" transform="rotate(180)" />
        <path d="M0 0 C-11 -14 -8 -25 0 -25 C8 -25 11 -14 0 0 Z" transform="rotate(270)" />
      </g>
      <circle r="5" fill="#1B2A4A" />
    </g>
    <circle class="cell cell-2" cx="270" cy="116" r="3" fill="#16A34A" />
  </g>
</svg>

<style>
  .ill {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blades {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: pwrSpin 16s linear infinite;
    }
    @keyframes pwrSpin {
      to {
        transform: rotate(360deg);
      }
    }

    /* a charge pulse travels the busbar from the UPS to the fan */
    .flow {
      animation: pwrFlow 4.5s ease-in-out infinite;
    }
    @keyframes pwrFlow {
      0% {
        transform: translateX(0);
        opacity: 0;
      }
      10%,
      90% {
        opacity: 1;
      }
      100% {
        transform: translateX(166px);
        opacity: 0;
      }
    }

    .cell {
      animation: pwrCell 3s ease-in-out infinite;
    }
    .cell-2 {
      animation-delay: 0.4s;
    }
    .cell-3 {
      animation-delay: 0.8s;
    }
    @keyframes pwrCell {
      0%,
      100% {
        opacity: 0.5;
      }
      50% {
        opacity: 1;
      }
    }
  }
</style>
