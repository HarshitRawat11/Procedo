---
/* IT Infrastructure — a server tower linking cloud, laptop and desktop.
   Palette and stroke weights match QuietScene.astro so the set reads as one
   family. All motion gated behind prefers-reduced-motion. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['ill', className]}
  viewBox="0 0 320 240"
  role="img"
  aria-labelledby="ill-it-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="ill-it-title">
    A server tower connected to a cloud, a laptop and a desktop monitor, with every status
    light green.
  </title>

  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- ground -->
    <ellipse cx="160" cy="197" rx="58" ry="5" fill="#F3F4F6" />
    <path d="M40 197 H280" stroke="#CBD5E1" stroke-width="2" />

    <!-- cloud -->
    <path
      d="M132 54 C125 54 123 43 133 41 C135 28 153 26 158 36 C166 28 181 34 181 44 C190 45 191 54 184 54 Z"
      fill="#FFFFFF"
      stroke="#1B2A4A"
      stroke-width="2"
    />

    <!-- laptop -->
    <rect x="36" y="124" width="46" height="32" rx="3" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <rect x="42" y="130" width="34" height="20" rx="2" fill="#F3F4F6" />
    <path d="M30 156 H88 L92 165 H26 Z" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <path d="M92 140 C106 140 114 137 130 137" stroke="#CBD5E1" stroke-width="2" />

    <!-- monitor -->
    <rect x="232" y="118" width="52" height="38" rx="3" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <rect x="238" y="124" width="40" height="26" rx="2" fill="#F3F4F6" />
    <path d="M258 156 V168 M246 168 H270" stroke="#1B2A4A" stroke-width="2" />
    <path d="M232 137 C216 137 206 137 190 137" stroke="#CBD5E1" stroke-width="2" />

    <!-- server tower -->
    <rect x="130" y="88" width="60" height="109" rx="6" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
    <rect x="138" y="96" width="44" height="22" rx="3" fill="#F3F4F6" />
    <rect x="138" y="124" width="44" height="22" rx="3" fill="#F3F4F6" />
    <rect x="138" y="152" width="44" height="22" rx="3" fill="#F3F4F6" />
    <circle class="led led-1" cx="147" cy="107" r="3" fill="#16A34A" />
    <circle class="led led-2" cx="147" cy="135" r="3" fill="#16A34A" />
    <circle class="led led-3" cx="147" cy="163" r="3" fill="#16A34A" />
    <g stroke="#CBD5E1" stroke-width="1.5">
      <path d="M160 103 H176 M160 107 H176 M160 111 H176" />
      <path d="M160 131 H176 M160 135 H176 M160 139 H176" />
      <path d="M160 159 H176 M160 163 H176 M160 167 H176" />
    </g>
    <path d="M138 185 H182" stroke="#CBD5E1" stroke-width="2" />

    <!-- uplink to cloud, drawn last so it sits above the tower -->
    <path d="M160 88 V58" stroke="#CBD5E1" stroke-width="2" />
    <circle class="uplink" cx="160" cy="84" r="3.5" fill="#F24E1E" />
  </g>
</svg>

<style>
  .ill {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .led {
      animation: itLed 2.4s ease-in-out infinite;
    }
    .led-2 {
      animation-delay: 0.5s;
    }
    .led-3 {
      animation-delay: 1s;
    }
    @keyframes itLed {
      0%,
      100% {
        opacity: 0.35;
      }
      50% {
        opacity: 1;
      }
    }

    .uplink {
      animation: itUplink 3.2s ease-in-out infinite;
    }
    @keyframes itUplink {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      15%,
      85% {
        opacity: 1;
      }
      100% {
        transform: translateY(-24px);
        opacity: 0;
      }
    }
  }
</style>
