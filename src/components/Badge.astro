---
// Small monospaced pill for trust badges / inline labels (light theme).
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
  class?: string;
}
const { icon, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border border-line bg-white px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-700 shadow-sm',
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-3.5 text-brand-500" aria-hidden="true" />}
  <slot />
</span>
