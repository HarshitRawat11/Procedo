---
/* ============================================================================
 *  CareersScene — the cat at the desk, working.
 *
 *  WHERE IT IS USED: the Careers page, in the open-application card beside
 *  "Don't see your role?". Adopted 2026-09-14. It replaced DeskScene and its
 *  failed intermediate DeskSceneWorking, both of which were deleted on
 *  Harshit's instruction the same day, once this one had shipped. They are
 *  recoverable from commit 9aeddcf if the history is ever wanted; do not
 *  resurrect them as drawings, because both failed Gate 1b.
 *
 *  The card gives it `w-56 lg:w-72` — 288px on a wide screen, up from 208px.
 *  At 208 the cat rendered 42px wide against the 404 cat's 78px and the
 *  monitor and mouse stopped reading; the measurements are in PROGRESS.md.
 *
 *  ── WHAT WAS WRONG, measured ────────────────────────────────────────────────
 *  · The monitor was a solid navy rectangle, 76x64 on a 400x264 canvas — 4.6%
 *    of the frame in flat dark, on a budget of 5%. The screen here is dark too,
 *    by request, but it is 50x42 on a 420 canvas: 2.1%. The fix was the scale,
 *    not the colour.
 *  · Four things ran off the edge — desk, monitor, floor line and pot. Nothing
 *    here touches an edge. "Draw objects, not walls."
 *  · The cat spanned 172 units of a 400 canvas: 43%, against the 404's 20.4%.
 *
 *  ── SAME HAND AS THE OTHER TWO ──────────────────────────────────────────────
 *  The cat is QuietScene's, path for path, placed by one translate — the same
 *  cat the contact scene uses, doing a third job. Stroke weights 2.0 / 1.8 /
 *  1.4, markings in #CBD5E1, the off-register body and head shading. The desk
 *  is ReceptionScene's desk, unchanged: careers and contact are the same room.
 *  The only difference in the face is that the pupils sit a unit to the right,
 *  because this cat is looking at the screen.
 *
 *  ── THINGS THAT MUST STAY TRUE ──────────────────────────────────────────────
 *  · The desk's top SURFACE is y=236. Everything on it has its base at 236 and
 *    nothing crosses that line — monitor foot, mouse, cat, all of them.
 *  · The cat's breathing and tail, the mug's steam and the wind in the plant
 *    and grass are NOT defined here. They are shared by every scene on the site
 *    and live in `src/styles/scene-motion.css`; this svg opts in with
 *    `data-scene`. Change a shared timing there, never here — that is the whole
 *    point of the file.
 *  · NEVER put a static `transform` attribute on an element that is also
 *    animated: a presentation attribute loses to an animation, so the CSS
 *    transform replaces it rather than composing with it. Static transforms go
 *    on a parent. This cost two commits on ReceptionScene.
 *  · THERE IS NO CHAIR. One was drawn at prop scale and removed on Harshit's
 *    instruction, 2026-09-14. The scene is a cat at a desk; the "the seat's
 *    yours" reading now has to come from the copy beside it, not the picture.
 *    Do not put it back without asking.
 *  · The screen is the ONE flat dark shape. Re-run Gate 1b whenever its size
 *    changes — at 50x42 it is 2.1% of the frame, and the ceiling is 5%.
 *  · The working paw must BREAK the mouse's outline, not sit inside it. The
 *    first cut had it wholly within, and it read as a hole cut in the mouse
 *    rather than a paw resting on one.
 *  · The mouse and the paw MOVE TOGETHER, in two `.mousing` groups sharing one
 *    keyframe. They are two groups rather than one only because the cat is
 *    drawn between them and has to stay there. If you add anything to the mouse
 *    — a scroll wheel, a second button — it goes inside the first group, or it
 *    will sit still while the mouse slides out from under it.
 *  · The mouse's LEAD starts at x=242, under the body, and is drawn before it.
 *    That is what lets the mouse travel without the cable detaching from it.
 * ========================================================================== */
interface Props {
  /** Unique per instance — several on one page must not share a title id. */
  id: string;
  class?: string;
}
const { id, class: className = '' } = Astro.props;
const titleId = `careers-scene-${id}`;

/* ── QuietScene's weights and palette, deliberately. ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#CBD5E1';
const W_SUBJ = 2;
const W_FACE = 1.8;
const W_FINE = 1.4;

const TIMBER = '#E4CBA8';
const GROUND = '#E3EAF3';
const DEVICE = '#C9D9EC'; // the 404 rack's own blue — screen, mouse, chair
/* Deliberately the same value as NAVY, and named separately because it is the
   one flat dark shape in the scene and the gate has to be re-run whenever it
   changes size. Harshit asked for the black screen back on 2026-09-14; it is
   affordable now only because the monitor is 50x42 on a 420 canvas (2.1% of the
   frame) where the old one was 76x64 on a 400 canvas (4.6%). Same decision,
   less than half the cost, because the scale was fixed first. */
const SCREEN = '#1B2A4A';
const FUR = '#FFFFFF';
const FUR_SHADE = '#B9C4D2';
const LEAF_A = '#7DD87D';
const LEAF_B = '#4EB86B';
const POT = '#FCDCCF';
const GRASS = '#3FAE5F';
const MUG = '#F7B9A3'; // QuietScene's mug, to the digit
const CLOUD = '#FFFFFF'; // QuietScene's cloud, top left of every scene
const ORANGE = '#F24E1E'; // and its one band of Procedo orange
const GREEN = '#3FAE5F'; // the status dot, the 404 rack's LED colour

/* QuietScene's cat, verbatim. */
const CAT_BODY = 'M180 128 C178 110 190 98 208 98 C226 98 242 106 244 128 Z';
const CAT_BACK =
  'M180 128 C178 110 190 98 208 98 C218 98 227 101 233 107 C214 104 192 112 186 128 Z';
const HEAD_SHADE = 'M226 110 C229 104 235 102 239 104 C233 105.5 228 108 226 113 Z';

/* The mouse: a rounded back with a button split, standing on the desk at 236. */
const MOUSE_BODY = 'M228 236 C228 230 233 226 240 226 C247 226 252 230 252 236 Z';
---

<figure class:list={['careers', className]}>
  <svg
    class="scene"
    data-scene
    viewBox="13 127 420 240"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A cat sitting on a desk with one paw on the mouse, watching the monitor.
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ── Cloud: QuietScene's own path, top left, as on every scene. Added
           2026-09-14 when Harshit set the one prop order for the whole site:
           cloud top left, then grass · mug · subject · plant · grass. The
           translate puts it 54 units in from this frame's left edge and 16 down
           from its top, matching the 404. It is on a STATIC parent because the
           drift is animated and a CSS transform replaces a transform attribute
           rather than composing with it. ── -->
      <g transform="translate(13 87)">
        <path
          class="cloud"
          d="M60 80 C55 80 54 71 61 69 C62 60 74 57 80 63 C86 56 99 59 100 68 C108 68 110 79 104 80 Z"
          fill={CLOUD}
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
      </g>

      <!-- ── Ground: the 404's own line, 81% of the canvas and touching neither
           edge ── -->
      <ellipse cx="224" cy="302" rx="100" ry="7" fill={GROUND} />
      <path d="M52 300 H394" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ══ DESK — ReceptionScene's desk, unchanged. Its top SURFACE is y=236.
               mis-registration 1: the timber colour sits 3 right / 2 down of
               its own outline. ══ -->
      <rect x="141" y="238" width="174" height="10" rx="2" fill={TIMBER} />
      <rect x="138" y="236" width="174" height="10" rx="2" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M150 246 V300" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M298 246 V300" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M150 286 H298" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ══ MONITOR — pale, outlined, standing on the surface. The old one was
               a solid navy slab and was most of the dark budget on its own. ══ -->
      <path d="M281 228 V236" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M268 236 C273 236 277 235 281 234 C285 235 289 236 294 236" stroke={NAVY} stroke-width={W_SUBJ} />
      <rect x="256" y="186" width="50" height="42" rx="3" fill={SCREEN} stroke={NAVY} stroke-width={W_SUBJ} />
      <g stroke={DEVICE} stroke-width={W_FINE}>
        <path d="M263 195 H296" />
        <path d="M263 202 H288" />
        <path d="M263 209 H293" />
      </g>
      <!-- the one saturated hit: a build that is passing, as on the 404's rack -->
      <circle class="pip" cx="265" cy="218" r="2.2" fill={GREEN} />
      <path d="M271 218 H289" stroke={DEVICE} stroke-width={W_FINE} />

      <!-- ══ MOUSE — under the paw, its lead running to the monitor foot.
               The mouse and the paw both sit in `.mousing` groups, which share
               one keyframe, so they travel together; the body and its button
               split are one group and the paw is another only because the cat
               is drawn between them and has to stay between them.

               THE LEAD STARTS AT x=242, UNDER THE BODY, and is drawn before it.
               It used to start at 252, on the body's right edge — fine while
               the mouse was still, and a cable detaching from its own mouse the
               moment it moved. At ±6 the body spans 222–258, so 242 is covered
               at both extremes; what the eye sees is the visible length of
               cable growing and shrinking, which is what slack does. ══ -->
      <path d="M242 233 C250 231 258 232 266 235" stroke={ENVLINE} stroke-width={W_FINE} />
      <g class="mousing">
        <path d={MOUSE_BODY} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M240 226 L240 231" stroke={ENVLINE} stroke-width={W_FINE} />
      </g>

      <!-- ══ CAT — QuietScene's own drawing, moved onto the desk by one
               translate, exactly as the contact scene does it. ══ -->
      <g transform="translate(-30 108)">
        <path class="tail" d="M182 126 C170 128 164 120 170 113 C174 108 181 110 181 116" stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <!-- mis-registration 2: the back shading, laid inside and short of its contour -->
          <path d={CAT_BACK} fill={FUR_SHADE} />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
          <g stroke={ENVLINE} stroke-width={W_SUBJ}>
            <path d="M193 102 Q197 107 195 112" />
            <path d="M203 99.5 Q207 104 205 109" />
          </g>
        </g>
        <ellipse cx="213" cy="124.5" rx="8.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="head">
          <path d="M227.5 108 L228 96 L237 103.5 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M241 103.5 L248 97 L247.5 110 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <circle cx="236" cy="116" r="12" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d={HEAD_SHADE} fill={FUR_SHADE} />
          <!-- awake, and the pupils sit a unit right: it is watching the screen -->
          <circle cx="232" cy="114" r="1.9" fill={NAVY} />
          <circle cx="243" cy="114" r="1.9" fill={NAVY} />
          <path d="M228.5 111 Q231 109.3 233.5 111" stroke={NAVY} stroke-width={W_FACE} />
          <path d="M239.5 111 Q242 109.3 244.5 111" stroke={NAVY} stroke-width={W_FACE} />
          <path d="M236 119.5 L236 121" stroke={NAVY} stroke-width={W_FACE} />
          <g stroke={ENVLINE} stroke-width={W_FINE}>
            <path d="M227 119 L222.5 118" />
            <path d="M245 119 L249.5 118" />
          </g>
        </g>
      </g>

      <!-- The working paw, out on the mouse. Two nested transforms: the outer
           group travels with the mouse, the ellipse clicks. They compose, which
           is exactly why the travel is NOT on the ellipse itself — a second
           animation on one element replaces the first rather than adding to it. -->
      <g class="mousing">
        <ellipse class="paw" cx="228" cy="228" rx="6.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ PLANT — RIGHT, between the desk and the grass. It stood on the left
               until 2026-09-14, as a counterweight to the dark screen, which
               sits right of centre. Harshit's site-wide order replaces that
               judgement: mug left, plant right, everywhere, so the four scenes
               read as one family. Leaves AND pot are the 404's paths untouched,
               inside one static parent — static so the sway cannot wipe the
               translate, one parent so the plant moves as a number. ══ -->
      <g transform="translate(11 8)">
        <g class="leaves">
          <path d="M330 274 C322 258 326 244 332 240 C338 246 338 262 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M330 274 C318 266 312 254 314 248 C322 250 330 262 330 274 Z" fill={LEAF_B} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M330 274 C342 266 348 256 346 250 C338 252 331 263 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
        </g>
        <path d="M314 274 L318 292 H342 L346 274 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M312 274 H348" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ MUG — QuietScene's own mug, verbatim: body, rim, handle, the one
               orange band and both steam wisps. Fourth of the four props the
               whole site shares — cat, plant, grass, mug — same colour and
               design wherever it appears — and from 2026-09-14, always on the
               LEFT, between the grass and the desk. On a STATIC parent, because
               the steam is animated and a CSS transform replaces a transform
               attribute rather than composing with it. ══ -->
      <g transform="translate(-8 8)">
        <g class="steam" stroke={ENVLINE} stroke-width={W_SUBJ}>
          <path class="wisp wisp-1" d="M103 262 C100 256 108 252 105 246" />
          <path class="wisp wisp-2" d="M112 262 C109 256 117 252 114 246" />
        </g>
        <path
          d="M96 268 L96 286 Q96 292 102 292 L114 292 Q120 292 120 286 L120 268 Z"
          fill={MUG}
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
        <rect x="97" y="278" width="22" height="5" fill={ORANGE} opacity="0.9" />
        <path d="M96 273 H120" stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M120 275 C130 275 130 287 120 287" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ GRASS — both sides, as on the 404 ══ -->
      <g stroke={GRASS} stroke-width="3.5">
        <g class="grass grass-b">
          <path d="M62 300 C61 292 64 285 69 280" />
          <path d="M69 300 C69 292 71 286 75 282" />
          <path d="M75 300 C75 293 74 288 72 284" />
        </g>
        <g class="grass">
          <path d="M372 300 C371 292 374 285 379 280" />
          <path d="M379 300 C379 292 381 286 385 282" />
          <path d="M385 300 C385 293 384 288 382 284" />
        </g>
      </g>
    </g>
  </svg>
</figure>

<style>
  .careers {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }
  .scene {
    display: block;
    width: 100%;
    /* the same cap QuietScene and ReceptionScene carry, so one cat is one size
       wherever it appears */
    max-width: 22rem;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* THE WORK ITSELF — the only motion this scene owns. Everything else the
       cat and the props do (breathing, the tail, the steam, the wind in the
       plant and grass) is shared across the whole site and lives in
       src/styles/scene-motion.css. Change a timing there, not here.

       Harshit, 2026-09-18: "careers image the cat should be moving the mouse
       back and forth and clicking." It was clicking a mouse that never moved,
       which reads as a twitch rather than as work. So there are now three
       keyframes on ONE 5.6s clock, and the order is the sentence: the mouse
       travels right, then left, then settles, and only THEN is it clicked. A
       click during the travel would read as a mis-click; a click that arrives
       after the pointer stops reads as a decision.

       Amplitude is ±6 user units, and the two limits are real. At -6 the paw's
       left edge is 7 units clear of the cat's body contour; at +6 the mouse's
       right edge is 10 clear of the monitor foot. Past either, the drawing
       collides with itself. */
    .mousing {
      animation: mouseSlide 5.6s ease-in-out infinite;
    }
    @keyframes mouseSlide {
      0%,
      4%,
      62%,
      100% {
        transform: translateX(0);
      }
      20% {
        transform: translateX(6px);
      }
      38% {
        transform: translateX(-6px);
      }
      52% {
        transform: translateX(2px);
      }
    }

    .paw {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: click 5.6s ease-in-out infinite;
    }
    @keyframes click {
      0%,
      64%,
      100% {
        transform: translateY(0);
      }
      69% {
        transform: translateY(2.6px);
      }
      74% {
        transform: translateY(0);
      }
      79% {
        transform: translateY(2.6px);
      }
      84% {
        transform: translateY(0);
      }
    }

    /* .head carries no transform ATTRIBUTE, so this has nothing to clobber —
       the static placement is on the cat's parent group. It tracks the mouse
       sideways on the same clock — a tenth of the mouse's own travel, which is
       enough to read as attention and not enough to read as a head wobble —
       then leans in for the two clicks. */
    .head {
      animation: peer 5.6s ease-in-out infinite;
    }
    @keyframes peer {
      0%,
      4%,
      100% {
        transform: translate(0, 0);
      }
      20% {
        transform: translate(0.9px, 0);
      }
      38% {
        transform: translate(-0.8px, 0);
      }
      62% {
        transform: translate(0, 0);
      }
      70%,
      84% {
        transform: translate(0, 1.2px);
      }
      92% {
        transform: translate(0, 0);
      }
    }

    .pip {
      animation: pip 2.6s ease-in-out infinite;
    }
    @keyframes pip {
      0%,
      100% {
        opacity: 0.4;
      }
      50% {
        opacity: 1;
      }
    }
  }
</style>
