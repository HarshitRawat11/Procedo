---
/* ============================================================================
 *  UptimeScene — "Power cut at 3am. Nobody noticed."
 *
 *  A storm outside a window; inside, a lamp still burning, a cat asleep on the
 *  sill, tea going cold, books. The UPS is never drawn — the point is the lamp
 *  that stayed on.
 *
 *  Follows reference/inspiration/ANALYSIS.md §6: depict the moment the service
 *  creates, not the equipment that delivers it. Living creature as the emotional
 *  anchor, warmth props, depth planes (storm → window → sill), dense detail.
 *
 *  ── Re-framed again 2026-09-17 ─────────────────────────────────────────────
 *  The ink is 268 wide by 218 tall — nearly square, where CareersScene and
 *  ReceptionScene are 420x240 and read wide. At a shared 20rem that made this
 *  scene 251px tall against their 183, and a page header carrying it came out
 *  96px taller than its siblings.
 *
 *  So the frame is 480x300 rather than 420x330: same drawing, same coordinates,
 *  more cream at the sides and less above and below. The ink is still centred in
 *  it — x 76–344 centres on 210, y 34–252 on 143, hence the -30 / -7 origin.
 *  Both weight gates improve, because widening a frame only adds cream.
 *
 *  ── Revised 2026-09-07 ─────────────────────────────────────────────────────
 *  1. The foreground leaf branch across the top-left corner is gone. Harshit's
 *     call — it did not read. With it removed the frame no longer needed the
 *     dead space either side, so the viewBox is cropped to the artwork: the
 *     window and sill now fill the frame instead of floating in it.
 *  2. Brought onto technique B, matching QuietScene and the 404 (DeskScene
 *     was the third example at the time; it was deleted on 2026-09-14):
 *     flat colour laid under the navy contours rather than white fills. The
 *     sill is timber, the books and mug carry colour, the cat has a shaded back.
 *  3. The lamplight was a `radialGradient` — the only gradient in the codebase,
 *     and ANALYSIS notes the reference set never uses one, rendering light as
 *     discrete strokes instead (the TV rays in reference 10). It is now a fan
 *     of strokes over a flat pool.
 *  4. The lamp stem sat at x=308 while its shade was centred on x=300. Both are
 *     now on 308, so the lamp is no longer subtly bent.
 *  5. Orange is now carried by the bulb and its light ALONE. The mug band used
 *     to be orange too, which split the accent; the lamp has to win that
 *     contest, because the lamp is the whole point of the picture.
 * ========================================================================== */
interface Props {
  chip?: string | null;
  caption?: string | null;
  surface?: 'bare' | 'panel';
  /** Unique per instance — the clip path and title must not share ids. */
  id?: string;
  class?: string;
}
const {
  chip = 'On backup power',
  caption = 'Power cut at 3am. Nobody noticed.',
  surface = 'panel',
  id = 'uptime',
  class: className = '',
} = Astro.props;

const clipId = `glass-${id}`;
const titleId = `uptime-title-${id}`;

const NAVY = '#1B2A4A';
const ENVLINE = '#A8BACF';
const ORANGE = '#F24E1E';
const WARM = '#FCDCCF';

const SKY = '#C7D2DE';
const CLOUD_BACK = '#AEBCCB';
const CLOUD_FRONT = '#B9C6D4';
const RAIN = '#E8EDF2';

const TIMBER = '#E4CBA8';
const FUR = '#FFFFFF';
const FUR_DK = '#B9C4D2';
const MUG = '#F7B9A3';
const BOOK_A = '#8FA8C8';
const SHADE = '#F7B9A3';
const METAL = '#8FA8C8';

/* Cat body: filled, shaded, then re-contoured, so the shading can sit off the
   line (Gate 1 mis-registration #1 — laid 3 right / 2 down of its contour). */
const CAT_BODY = 'M124 228 C124 198 144 184 168 184 C192 184 212 198 212 228 Z';
const CAT_BACK = 'M124 228 C124 198 144 184 168 184 C186 184 200 190 208 202 C186 194 148 200 134 228 Z';
---

<figure class:list={['uptime', surface === 'panel' && 'uptime--panel', className]}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    viewBox="-28 -7 480 300"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A storm rages outside a window at night while inside, undisturbed, a desk lamp still burns
      over a cat asleep on the windowsill beside a mug of tea and a stack of books.
    </title>

    <defs>
      <clipPath id={clipId}>
        <rect x="98" y="46" width="224" height="170" rx="4" />
      </clipPath>
    </defs>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ══ PLANE 1: the storm, behind glass ══ -->
      <rect x="98" y="46" width="224" height="170" rx="4" fill={SKY} />

      <g clip-path={`url(#${clipId})`}>
        <g class="clouds">
          <path
            d="M112 92 C104 92 102 80 112 78 C114 66 132 63 138 73 C148 64 165 70 165 82 C175 83 176 92 168 92 Z"
            fill={CLOUD_BACK}
          />
          <path
            d="M256 88 C249 88 247 78 256 76 C258 66 273 64 278 72 C286 65 300 70 300 80 C308 81 309 88 302 88 Z"
            fill={CLOUD_BACK}
          />
        </g>
        <path
          class="clouds-front"
          d="M176 104 C166 104 164 90 176 88 C178 74 200 70 208 82 C220 71 240 79 240 93 C252 94 253 104 244 104 Z"
          fill={CLOUD_FRONT}
        />

        <!-- a distant strike, soft and infrequent. Resting opacity is an
             attribute, so reduced-motion gets a faint bolt, not a bright one. -->
        <path
          class="bolt"
          d="M236 98 L220 128 L232 128 L224 154 L248 120 L234 120 Z"
          fill="#FDE68A"
          opacity="0.22"
        />

        <!-- rain: rows 30 apart, pattern repeating every 2 rows, so a 60
             translate loops seamlessly -->
        <g class="rain" stroke={RAIN} stroke-width="2">
          <path d="M108 -30 l-6 15 M148 -30 l-6 15 M188 -30 l-6 15 M228 -30 l-6 15 M268 -30 l-6 15 M308 -30 l-6 15 M126 0 l-6 15 M166 0 l-6 15 M206 0 l-6 15 M246 0 l-6 15 M286 0 l-6 15 M326 0 l-6 15 M108 30 l-6 15 M148 30 l-6 15 M188 30 l-6 15 M228 30 l-6 15 M268 30 l-6 15 M308 30 l-6 15 M126 60 l-6 15 M166 60 l-6 15 M206 60 l-6 15 M246 60 l-6 15 M286 60 l-6 15 M326 60 l-6 15 M108 90 l-6 15 M148 90 l-6 15 M188 90 l-6 15 M228 90 l-6 15 M268 90 l-6 15 M308 90 l-6 15 M126 120 l-6 15 M166 120 l-6 15 M206 120 l-6 15 M246 120 l-6 15 M286 120 l-6 15 M326 120 l-6 15 M108 150 l-6 15 M148 150 l-6 15 M188 150 l-6 15 M228 150 l-6 15 M268 150 l-6 15 M308 150 l-6 15 M126 180 l-6 15 M166 180 l-6 15 M206 180 l-6 15 M246 180 l-6 15 M286 180 l-6 15 M326 180 l-6 15 M108 210 l-6 15 M148 210 l-6 15 M188 210 l-6 15 M228 210 l-6 15 M268 210 l-6 15 M308 210 l-6 15 M126 240 l-6 15 M166 240 l-6 15 M206 240 l-6 15 M246 240 l-6 15 M286 240 l-6 15 M326 240 l-6 15" />
          </g>

        <!-- water running down the inside of the pane -->
        <g stroke="#DCE4EC" stroke-width="2" opacity="0.7">
          <path d="M132 52 C136 74 130 96 134 118" />
          <path d="M268 60 C272 84 266 108 270 132" />
        </g>
      </g>

      <!-- ══ PLANE 2: the window ══ -->
      <rect x="86" y="34" width="248" height="194" rx="8" stroke={NAVY} stroke-width="2.8" />
      <path d="M210 46 V216" stroke={NAVY} stroke-width="2.8" />
      <path d="M98 131 H322" stroke={NAVY} stroke-width="2.8" />

      <!-- ══ PLANE 3: the sill and what sits on it ══ -->
      <rect x="76" y="228" width="268" height="12" rx="3" fill={TIMBER} stroke={NAVY} stroke-width="2.8" />
      <ellipse cx="210" cy="246" rx="116" ry="7" fill="#E3EAF3" />
      <path d="M88 240 H332" stroke={ENVLINE} stroke-width="2" />

      <!-- the lamplight: a flat pool with a fan of strokes over it. This used to
           be a radial gradient; the reference set renders light as strokes. -->
      <ellipse class="glow" cx="308" cy="230" rx="42" ry="9" fill={WARM} opacity="0.5" />
      <g class="rays" stroke={WARM} stroke-width="2" opacity="0.75">
        <path d="M300 206 L288 226" />
        <path d="M308 206 L308 226" />
        <path d="M316 206 L328 226" />
      </g>

      <!-- books -->
      <rect x="84" y="221" width="38" height="7" rx="1.5" fill={BOOK_A} stroke={NAVY} stroke-width="2" />
      <rect x="88" y="213" width="32" height="8" rx="1.5" fill={WARM} stroke={NAVY} stroke-width="2" />
      <path d="M92 217 H116" stroke={ENVLINE} stroke-width="1.5" />

      <!-- cat, curled and asleep -->
      <g class="cat">
        <path
          class="tail"
          d="M210 226 C196 236 160 238 136 230 C126 226 124 218 130 214"
          stroke={NAVY}
          stroke-width="2"
        />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width="2" />
          <path d={CAT_BACK} fill={FUR_DK} transform="translate(3 2)" />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width="2" />
          {/* Darker than the shaded back on purpose. At #CBD5E1 these were
              lighter than the grey they sat on and read as rain landing on the
              cat rather than as markings. */}
          <g stroke="#93A3B8" stroke-width="2">
            <path d="M146 191 Q150 197 148 203" />
            <path d="M160 187 Q164 193 162 199" />
            <path d="M174 186 Q178 192 176 198" />
          </g>
        </g>
        <ellipse cx="176" cy="223" rx="10" ry="4.5" fill={FUR} stroke={NAVY} stroke-width="2" />
        <path d="M186 200 L184 187 L196 195 Z" fill={FUR} stroke={NAVY} stroke-width="2" />
        <path d="M201 194 L211 186 L212 199 Z" fill={FUR} stroke={NAVY} stroke-width="2" />
        <circle cx="198" cy="210" r="16" fill={FUR} stroke={NAVY} stroke-width="2" />
        <path d="M186 204 C190 197 196 194 202 195 C194 197 189 202 187 208 Z" fill={FUR_DK} />
        <path d="M189 208 Q192.5 211.5 196 208" stroke={NAVY} stroke-width="1.8" />
        <path d="M203 208 Q206.5 211.5 210 208" stroke={NAVY} stroke-width="1.8" />
        <path d="M199 215 L199 216.5" stroke={NAVY} stroke-width="1.8" />
        <g stroke="#CBD5E1" stroke-width="1.4">
          <path d="M187 216 L180 217" />
          <path d="M211 216 L218 217" />
        </g>
      </g>

      <!-- tea, going cold -->
      <g class="steam" stroke="#CBD5E1" stroke-width="2">
        <path class="wisp wisp-1" d="M248 194 C244 187 253 182 249 175" />
        <path class="wisp wisp-2" d="M259 194 C255 187 264 182 260 175" />
      </g>
      <path
        d="M240 200 L240 220 Q240 228 248 228 L262 228 Q270 228 270 220 L270 200 Z"
        fill={MUG}
        stroke={NAVY}
        stroke-width="2"
      />
      <rect x="241" y="211" width="28" height="6" fill={BOOK_A} />
      <path d="M240 205 H270" stroke={NAVY} stroke-width="2" />
      <path d="M270 207 C281 207 281 220 270 220" stroke={NAVY} stroke-width="2" />

      <!-- the lamp that stayed on. Stem, shade and bulb all centred on 308. -->
      <path d="M296 228 L299 220 H317 L320 228 Z" fill={METAL} stroke={NAVY} stroke-width="2" />
      <path d="M308 220 V178" stroke={NAVY} stroke-width="2.5" />
      <path d="M288 186 Q308 162 328 186 Z" fill={SHADE} stroke={NAVY} stroke-width="2" />
      <circle class="bulb" cx="308" cy="186" r="5" fill={ORANGE} opacity="0.85" />
      <path d="M320 226 C332 230 337 240 339 252" stroke={ENVLINE} stroke-width="2" />
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .uptime {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .uptime--panel {
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-band);
    padding: 1.75rem 1.25rem 2rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }

  .scene {
    display: block;
    width: 100%;
    max-width: 24rem;
    height: auto;
    margin-top: 0.5rem;
  }

  .line {
    max-width: 30ch;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  /* ======================================================================
     Motion — the storm moves, the room does not. That contrast is the point.
     ==================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    /* 60 is exactly two rows, so the loop is seamless */
    .rain {
      animation: rainFall 1.1s linear infinite;
    }
    @keyframes rainFall {
      to {
        transform: translateY(60px);
      }
    }

    .clouds {
      animation: cloudDrift 26s ease-in-out infinite alternate;
    }
    .clouds-front {
      animation: cloudDrift 19s ease-in-out infinite alternate-reverse;
    }
    @keyframes cloudDrift {
      from {
        transform: translateX(-8px);
      }
      to {
        transform: translateX(10px);
      }
    }

    /* a soft bloom, not a snap — it must not break the calm */
    .bolt {
      animation: boltFlash 11s ease-in-out infinite;
    }
    @keyframes boltFlash {
      0%,
      86%,
      100% {
        opacity: 0.22;
      }
      90% {
        opacity: 0.55;
      }
      94% {
        opacity: 0.3;
      }
    }

    .breathe {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: catBreathe 4.8s ease-in-out infinite;
    }
    @keyframes catBreathe {
      0%,
      100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(1.035);
      }
    }

    .tail {
      transform-box: fill-box;
      transform-origin: 100% 50%;
      animation: catTail 12s ease-in-out infinite;
    }
    @keyframes catTail {
      0%,
      84%,
      100% {
        transform: rotate(0deg);
      }
      90% {
        transform: rotate(-2.5deg);
      }
      95% {
        transform: rotate(1.5deg);
      }
    }

    .wisp {
      opacity: 0;
      animation: teaWisp 4.4s ease-in-out infinite;
    }
    .wisp-2 {
      animation-delay: 1.8s;
    }
    @keyframes teaWisp {
      0% {
        opacity: 0;
        transform: translateY(4px);
      }
      40% {
        opacity: 0.7;
      }
      100% {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    /* resting values live on the elements as attributes, so reduced-motion
       keeps the lamp at a sensible brightness rather than jumping to full */
    .glow {
      animation: lampGlow 6s ease-in-out infinite;
    }
    @keyframes lampGlow {
      0%,
      100% {
        opacity: 0.42;
      }
      50% {
        opacity: 0.6;
      }
    }
    .rays {
      animation: rayGlow 6s ease-in-out infinite;
    }
    @keyframes rayGlow {
      0%,
      100% {
        opacity: 0.62;
      }
      50% {
        opacity: 0.85;
      }
    }
    .bulb {
      animation: bulbGlow 6s ease-in-out infinite;
    }
    @keyframes bulbGlow {
      0%,
      100% {
        opacity: 0.75;
      }
      50% {
        opacity: 1;
      }
    }

    .chip-dot {
      animation: dotPulse 2.4s ease-in-out infinite;
    }
    @keyframes dotPulse {
      0%,
      100% {
        opacity: 0.35;
      }
      50% {
        opacity: 1;
      }
    }
  }
</style>
