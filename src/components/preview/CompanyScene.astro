---
/* ============================================================================
 *  CompanyScene — "Every tool in its place. Nearly." PREVIEW ONLY.
 *
 *  Replaces WorkshopScene, which kept the joke but failed Gate 1b on both
 *  counts: 29.7% bare cream against a floor of 60, and 7.2% dark against a
 *  ceiling of 5. That component is left on disk until this one is approved.
 *
 *  ── THE COMPOSITION IS THE 404's ────────────────────────────────────────────
 *  A tall object with the cat ON TOP of it, props either side, a cloud above.
 *  Stacking is the only arrangement that fits a board big enough for legible
 *  tools AND a cat at full 20.4% size: side by side they need over 200 units and
 *  the props have nowhere left to stand.
 *
 *  Two earlier attempts are worth not repeating. A 100x72 board on a bench was
 *  quiet, gate-passing and unreadable — at 352px it came out 84px wide with 7px
 *  tools, and you could not see anything was missing. A 136x142 board with the
 *  cat on the floor in front read fine but squashed the cat to a lump.
 *
 *  ── THE JOKE ────────────────────────────────────────────────────────────────
 *  Six slots, two rows of three. Every tool hangs over its own painted outline;
 *  slot two is bare, because that screwdriver is up top under a paw. site.ts
 *  carries the caption, so the bare outline must stay legible at 352px — that
 *  constraint sets the tool size, not the other way round.
 *
 *  ── THE LOOP ────────────────────────────────────────────────────────────────
 *  16 seconds, on Harshit's brief: the cat sleeps with every tool in its place ·
 *  it wakes · it takes the screwdriver off the board and plays with it · it
 *  knocks it off the edge · it goes back to sleep · the screwdriver puts itself
 *  back · repeat. The percentages are in the style block and they must stay in
 *  step with each other.
 *
 *  ── THE RESTING STATE IS THE CAPTION'S MOMENT ───────────────────────────────
 *  Every SVG *attribute* describes the frame the caption is about: eyes open,
 *  screwdriver up top under the paw, slot two bare. Reduced motion gets that;
 *  so do the gate scripts, which render attributes and ignore CSS. The tool's
 *  attribute transform and its 26%/52% keyframe are deliberately the same pose.
 *
 *  ── THINGS THAT MUST STAY TRUE ──────────────────────────────────────────────
 *  · The GROUND is y=300 and the board's base sits on it. Nothing crosses it.
 *  · A tool is OUTLINED (pale fill, navy contour). Its painted outline is FLAT
 *    (one fill, no stroke), offset 2 left / 2 down. That contrast is the only
 *    thing telling a viewer which slot is empty — never stroke the outlines.
 *  · The screwdriver is drawn ONCE, vertical, at its slot. Everywhere else it
 *    goes is a transform, so the tool and its own painted outline can never
 *    drift apart.
 *  · Breathing, the tail, the steam, the wind and the cloud's drift are NOT
 *    here. They are shared by every scene and live in
 *    src/styles/scene-motion.css; this svg opts in with `data-scene`.
 * ========================================================================== */
interface Props {
  /** Small mono status label above the art, as on QuietScene. Omit for none. */
  chip?: string;
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — the title id must not collide. */
  id: string;
  class?: string;
}
const { chip, caption, id, class: className = '' } = Astro.props;
const titleId = `company-scene-${id}`;

/* ── QuietScene's weights and palette, deliberately. ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#CBD5E1';
const W_SUBJ = 2;
const W_FACE = 1.8;
const W_FINE = 1.4;

const GROUND = '#E3EAF3';
const DEVICE = '#C9D9EC'; // the 404 rack's own blue — the board and its tools
const KEYS = '#8FA8C8';
const FUR = '#FFFFFF';
const FUR_SHADE = '#B9C4D2'; // and the painted outlines: flat, never stroked
const LEAF_A = '#7DD87D';
const LEAF_B = '#4EB86B';
const POT = '#FCDCCF';
const GRASS = '#3FAE5F';
const MUG = '#F7B9A3';
const CLOUD = '#FFFFFF';
const ORANGE = '#F24E1E'; // the screwdriver's handle, and nothing else

/* QuietScene's cat, verbatim. */
const CAT_BODY = 'M180 128 C178 110 190 98 208 98 C226 98 242 106 244 128 Z';
const CAT_BACK =
  'M180 128 C178 110 190 98 208 98 C218 98 227 101 233 107 C214 104 192 112 186 128 Z';
const HEAD_SHADE = 'M226 110 C229 104 235 102 239 104 C233 105.5 228 108 226 113 Z';

/* ── The six slots. Each shape is declared once and used twice: flat as the
      painted outline, then outlined as the tool. Columns at 186 / 220 / 254,
      rows at 136–190 and 214–268. ── */
const SPANNER =
  'M181 190 L181 157 C174 154 170 148 170 141 C170 132 177 126 186 126 C195 126 202 132 202 141 C202 148 198 154 191 157 L191 190 C191 193 181 193 181 190 Z';
const PLIER_HEAD = 'M247 136 L261 136 L263 152 L254 158 L245 152 Z';
const PLIER_LEFT = 'M249 160 C246 170 244 180 244 190 L250 190 C250 180 252 170 255 162 Z';
const PLIER_RIGHT = 'M259 160 C262 170 264 180 264 190 L258 190 C258 180 256 170 253 162 Z';
const HAMMER =
  'M172 216 L200 216 C202 216 202 218 202 220 L202 224 C202 226 202 228 200 228 L191 228 L191 266 C191 269 181 269 181 266 L181 228 L172 228 C170 228 170 226 170 224 L170 220 C170 218 170 216 172 216 Z';
const TAPE_BODY = 'M213 214 L227 214 C234 214 236 219 236 227 L236 235 C236 243 234 248 227 248 L213 248 C206 248 204 243 204 235 L204 227 C204 219 206 214 213 214 Z';
const TAPE_TONGUE = 'M215 248 L225 248 L225 262 L215 262 Z';
const COIL_OUTER =
  'M254 214 C266 214 269 226 269 240 C269 254 266 266 254 266 C242 266 239 254 239 240 C239 226 242 214 254 214 Z';
const COIL_INNER =
  'M254 225 C259 225 261 232 261 240 C261 248 259 255 254 255 C249 255 247 248 247 240 C247 232 249 225 254 225 Z';

/* Slot two's tool: drawn ONCE, vertical, in its slot. Its bounding box is
   x 211–229, y 132–190, so its centre is (220, 161) — every transform below
   rotates about that. */
const SD_HANDLE = 'M211 137 C211 132 229 132 229 137 L229 163 C229 168 211 168 211 163 Z';
const SD_SHAFT = 'M217 168 L223 168 L222.5 184 L217.5 184 Z';
const SD_BLADE = 'M215.5 184 L224.5 184 L224.5 190 L215.5 190 Z';
---

<figure class:list={['company', className]}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    data-scene
    viewBox="13 18 420 330"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A workshop shadow board with six tools, each hanging over its own painted outline. One
      outline is bare: a cat sitting on top of the board has that screwdriver under its paw.
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ── Cloud: QuietScene's own, as a shared prop ── -->
      <path
        class="cloud"
        d="M60 80 C55 80 54 71 61 69 C62 60 74 57 80 63 C86 56 99 59 100 68 C108 68 110 79 104 80 Z"
        fill={CLOUD}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />

      <!-- ── Ground: the 404's own line, and it reaches neither edge ── -->
      <ellipse cx="224" cy="302" rx="100" ry="7" fill={GROUND} />
      <path d="M52 300 H394" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ══ THE BOARD — the hero object, the job the rack does on the 404.
               136 x 180, with cream on every side of it. ══ -->
      <rect x="152" y="120" width="136" height="180" rx="4" fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <g fill={KEYS}>
        <circle cx="161" cy="129" r="1.5" />
        <circle cx="279" cy="129" r="1.5" />
        <circle cx="161" cy="291" r="1.5" />
        <circle cx="279" cy="291" r="1.5" />
      </g>

      <!-- The painted outlines. FLAT — one fill, no stroke — because that is the
           only thing that tells a tool apart from the space where one should be.
           Laid 2 left / 2 down: a real shadow board is mis-registered too. -->
      <g fill={FUR_SHADE} transform="translate(-2 2)">
        <path d={SPANNER} />
        <path d={PLIER_HEAD} />
        <path d={PLIER_LEFT} />
        <path d={PLIER_RIGHT} />
        <path d={HAMMER} />
        <path d={TAPE_BODY} />
        <path d={TAPE_TONGUE} />
        <path d={COIL_OUTER} />
        <!-- SLOT TWO. Nothing hangs here while the cat has it. The caption
             depends on this outline being visible. -->
        <path d={SD_HANDLE} />
        <path d={SD_SHAFT} />
        <path d={SD_BLADE} />
      </g>

      <!-- hooks: two rows of three -->
      <g stroke={NAVY} stroke-width={W_FINE}>
        <path d="M186 128 L186 136" />
        <path d="M220 128 L220 136" />
        <path d="M254 128 L254 136" />
        <path d="M186 206 L186 214" />
        <path d="M220 206 L220 214" />
        <path d="M254 206 L254 214" />
      </g>

      <!-- row 1 · ring spanner -->
      <path d={SPANNER} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <circle cx="186" cy="141" r="6" fill={DEVICE} stroke={NAVY} stroke-width={W_FINE} />

      <!-- row 1 · slot two: nothing. The screwdriver is up top. -->

      <!-- row 1 · pliers -->
      <path d={PLIER_HEAD} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={PLIER_LEFT} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={PLIER_RIGHT} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <circle cx="254" cy="159" r="2.4" fill={NAVY} />

      <!-- row 2 · hammer -->
      <path d={HAMMER} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M170 222 H202" stroke={NAVY} stroke-width={W_FINE} />

      <!-- row 2 · tape measure -->
      <path d={TAPE_BODY} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={TAPE_TONGUE} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <circle cx="220" cy="231" r="6" fill={DEVICE} stroke={NAVY} stroke-width={W_FINE} />

      <!-- row 2 · a coiled cable -->
      <path d={COIL_OUTER} fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={COIL_INNER} fill={DEVICE} stroke={NAVY} stroke-width={W_FINE} />
      <rect x="245" y="236" width="18" height="7" rx="2" fill={KEYS} stroke={NAVY} stroke-width={W_FINE} />

      <!-- ══ CAT — QuietScene's own drawing, on top of the board ══ -->
      <g transform="translate(8 -8)">
        <path class="tail" d="M182 126 C170 128 164 120 170 113 C174 108 181 110 181 116" stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <!-- mis-registration: the back shading, laid inside and short of its contour -->
          <path d={CAT_BACK} fill={FUR_SHADE} />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
          <g stroke={ENVLINE} stroke-width={W_SUBJ}>
            <path d="M193 102 Q197 107 195 112" />
            <path d="M203 99.5 Q207 104 205 109" />
          </g>
        </g>
        <ellipse cx="213" cy="124.5" rx="8.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="head">
          <path d="M227.5 108 L228 96 L237 103.5 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M241 103.5 L248 97 L247.5 110 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <circle cx="236" cy="116" r="12" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d={HEAD_SHADE} fill={FUR_SHADE} />
          <!-- asleep: QuietScene's own closed, contented eyes -->
          <g class="eyes-shut" opacity="0" stroke={NAVY} stroke-width={W_FACE}>
            <path d="M228 114 Q231 117 234 114" />
            <path d="M239 114 Q242 117 245 114" />
          </g>
          <!-- awake, pupils low and right: looking at what it has taken -->
          <g class="eyes-open">
            <circle cx="232" cy="115" r="1.9" fill={NAVY} />
            <circle cx="243" cy="115" r="1.9" fill={NAVY} />
            <path d="M228.5 111 Q231 109.3 233.5 111" stroke={NAVY} stroke-width={W_FACE} />
            <path d="M239.5 111 Q242 109.3 244.5 111" stroke={NAVY} stroke-width={W_FACE} />
          </g>
          <path d="M236 119.5 L236 121" stroke={NAVY} stroke-width={W_FACE} />
          <g stroke={ENVLINE} stroke-width={W_FINE}>
            <path d="M227 119 L222.5 118" />
            <path d="M245 119 L249.5 118" />
          </g>
        </g>
      </g>

      <!-- ══ THE SCREWDRIVER. Drawn once, vertical, in its slot; the attribute
               transform is the pose the caption is about — up top, horizontal,
               half over the edge — and the 26%/52% keyframe repeats it exactly.
               Everywhere else it goes is another transform, so the tool and its
               own painted outline can never drift apart. ══ -->
      <g class="tool" transform="translate(71 -50) rotate(-90 220 161)">
        <path d={SD_HANDLE} fill={ORANGE} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d={SD_SHAFT} fill={KEYS} stroke={NAVY} stroke-width={W_FINE} />
        <path d={SD_BLADE} fill={KEYS} stroke={NAVY} stroke-width={W_FINE} />
      </g>
      <ellipse class="paw" cx="270" cy="105" rx="6.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- ══ MUG — the shared prop, on a static parent so the steam animation
               cannot wipe the translate ══ -->
      <g transform="translate(234 8)">
        <g class="steam" stroke={ENVLINE} stroke-width={W_SUBJ}>
          <path class="wisp wisp-1" d="M103 262 C100 256 108 252 105 246" />
          <path class="wisp wisp-2" d="M112 262 C109 256 117 252 114 246" />
        </g>
        <path
          d="M96 268 L96 286 Q96 292 102 292 L114 292 Q120 292 120 286 L120 268 Z"
          fill={MUG}
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
        <rect x="97" y="278" width="22" height="5" fill={ORANGE} opacity="0.9" />
        <path d="M96 273 H120" stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M120 275 C130 275 130 287 120 287" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ PLANT — the shared prop, static parent, same reason ══ -->
      <g transform="translate(-224 8)">
        <g class="leaves">
          <path d="M330 274 C322 258 326 244 332 240 C338 246 338 262 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M330 274 C318 266 312 254 314 248 C322 250 330 262 330 274 Z" fill={LEAF_B} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M330 274 C342 266 348 256 346 250 C338 252 331 263 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
        </g>
      </g>
      <path d="M90 282 L94 300 H118 L122 282 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M88 282 H124" stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- ══ GRASS — both sides, as on the 404 ══ -->
      <g stroke={GRASS} stroke-width="3.5">
        <g class="grass grass-b">
          <path d="M62 300 C61 292 64 285 69 280" />
          <path d="M69 300 C69 292 71 286 75 282" />
          <path d="M75 300 C75 293 74 288 72 284" />
        </g>
        <g class="grass">
          <path d="M372 300 C371 292 374 285 379 280" />
          <path d="M379 300 C379 292 381 286 385 282" />
          <path d="M385 300 C385 293 384 288 382 284" />
        </g>
      </g>
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .company {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }
  .scene {
    display: block;
    width: 100%;
    /* the cap every scene carries, so one cat is one size wherever it appears */
    max-width: 22rem;
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* ── THE LOOP ──────────────────────────────────────────────────────────
       16 seconds, and the three animations below are one gesture split three
       ways, so their percentages must stay in step:

            0%   0.0s   asleep, every tool in its place
           22%   3.5s   it wakes
           27%   4.3s   the screwdriver is off the board and under the paw
        33–47%   5–7.5s three bats
           54%   8.6s   the push that knocks it off
           56%   9.0s   it lands
           65%  10.4s   back to sleep, the screwdriver on the floor
        82–88%  13–14s  the screwdriver puts itself back
          100%  16.0s   loop

       Breathing, the tail, the steam, the wind and the cloud are shared with
       every other scene — src/styles/scene-motion.css. Nothing here duplicates
       them. ── */

    .tool {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: journey 16s ease-in-out infinite;
    }
    @keyframes journey {
      0%,
      20% {
        transform: translate(0, 0) rotate(0deg);
      }
      26% {
        transform: translate(71px, -50px) rotate(-90deg);
      }
      33% {
        transform: translate(71px, -50px) rotate(-84deg);
      }
      39% {
        transform: translate(71px, -50px) rotate(-96deg);
      }
      45% {
        transform: translate(71px, -50px) rotate(-85deg);
      }
      52% {
        transform: translate(71px, -50px) rotate(-90deg);
      }
      56%,
      82% {
        transform: translate(-3px, 129px) rotate(-90deg);
      }
      88%,
      100% {
        transform: translate(0, 0) rotate(0deg);
      }
    }

    .paw {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: reach 16s ease-in-out infinite;
    }
    @keyframes reach {
      0%,
      21% {
        transform: translate(-38px, 11px);
      }
      27% {
        transform: translate(0, 0);
      }
      33% {
        transform: translate(0, 2.6px);
      }
      37% {
        transform: translate(0, 0);
      }
      43% {
        transform: translate(0, 2.6px);
      }
      47% {
        transform: translate(0, 0);
      }
      54% {
        transform: translate(4px, 3px);
      }
      58% {
        transform: translate(0, 0);
      }
      64%,
      100% {
        transform: translate(-38px, 11px);
      }
    }

    /* the eyes are a hard cut, not a fade. Cats do not dissolve. */
    .eyes-shut {
      animation: shut 16s linear infinite;
    }
    @keyframes shut {
      0%,
      21.9% {
        opacity: 1;
      }
      22%,
      64.9% {
        opacity: 0;
      }
      65%,
      100% {
        opacity: 1;
      }
    }
    .eyes-open {
      animation: waken 16s linear infinite;
    }
    @keyframes waken {
      0%,
      21.9% {
        opacity: 0;
      }
      22%,
      64.9% {
        opacity: 1;
      }
      65%,
      100% {
        opacity: 0;
      }
    }
  }
</style>
