---
/* ============================================================================
 *  RackScene — "Always leave room to grow." PREVIEW ONLY.
 *
 *  ── WHAT THIS REPLACES, AND WHY ─────────────────────────────────────────────
 *  The previous RackScene was a close view of a rack FACE, filling the frame
 *  edge to edge. It failed Gate 1b harder than anything else on the site:
 *  0.2% bare cream against a floor of 60, and 30.0% dark against a ceiling of 5.
 *  It was not a refinement problem — it was a wall, and the loop exists to stop
 *  exactly that. Recoverable from git if the old drawing is ever wanted.
 *
 *  This is the same joke redrawn as an OBJECT standing on cream, in the family
 *  composition every other scene now uses: cloud top left, then along the
 *  ground, grass · mug · subject · plant · grass.
 *
 *  ── THE JOKE ────────────────────────────────────────────────────────────────
 *  A cabinet with four units. Three are full — a patch panel, a switch with its
 *  lights, a blank filler. The fourth is the spare U every competent design
 *  leaves, and the cat has moved into it. site.ts carries the caption; the chip
 *  says "One U spare", which is the line the picture is arguing with.
 *
 *  ── HOW IT DIFFERS FROM QuietScene, DELIBERATELY ────────────────────────────
 *  QuietScene (the 404 and /our-mission) is also a cat and a rack, so these two
 *  must not read as the same picture. QuietScene's rack is tall and narrow with
 *  the cat perched ON TOP of it. This cabinet is wider than it is tall, its
 *  front is a visible stack of slots, and the cat is INSIDE one — ears breaking
 *  the shelf above, tail lying along the slot floor. Silhouette and joke both
 *  differ; only the hand is shared.
 *
 *  ── THE FRAME IS TIGHTER THAN THE FAMILY'S ─────────────────────────────────
 *  380x275, not the 420x330 the other scenes use. The cat is the same 68 units
 *  it is everywhere — that rule holds — but here it sits INSIDE a bay with ports,
 *  LEDs and two shelves competing with it, where QuietScene's sits on top of a
 *  rack against open cream. At the 420 frame it rendered 57px wide in the hero
 *  panel and lost the contest; the drawing was fine and the framing was not.
 *  Cropping to the ink rather than shrinking the props keeps every proportion.
 *
 *  It cannot go much tighter, and the reason is worth writing down: cropping
 *  removes cream and keeps every navy contour, so Gate 1b's DARK share rises as
 *  the frame shrinks. 360x260 measured 5.4% against a 5% ceiling; thinning the
 *  ports barely moved it, because the contours are the dark, not the detail.
 *  380x275 is the tightest frame that still passes. The rest of the size the
 *  subject needs has to come from rendering it larger — which costs no gate at
 *  all, because the gates measure the drawing and not its display width.
 *
 *  ── THINGS THAT MUST STAY TRUE ──────────────────────────────────────────────
 *  · The GROUND is y=300 and the cabinet's base sits on it. Nothing crosses it.
 *  · NO DARK FILLS. Navy is contours only. The old version's 30% dark came from
 *    filled faceplates; every face here is DEVICE or KEYS, and the empty bay is
 *    GROUND so it reads as a recess rather than a hole cut in the picture.
 *  · The cat's EARS must break the shelf above the empty bay. That overlap is
 *    what says "in", not "in front of" — and it is one of the two Gate 0
 *    overlaps (the other is the cabinet standing on the ground ellipse).
 *  · Breathing, the tail, the steam, the wind and the cloud's drift are NOT
 *    here. They are shared by every scene and live in
 *    src/styles/scene-motion.css; this svg opts in with `data-scene`. Only the
 *    switch LEDs belong to this scene.
 * ========================================================================== */
interface Props {
  /** Small mono status label above the art, as on QuietScene. Omit for none. */
  chip?: string;
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — the title id must not collide. */
  id: string;
  class?: string;
  /**
   * Cap on the rendered width. 22rem is the site-wide default, so one cat is
   * one size wherever it appears; the home hero passes more, because it is the
   * largest slot on the site and the art is the headline's counterweight there.
   *
   * It is a PROP and a custom property rather than a utility class on the
   * wrapper, because Astro's scoped styles compile to `.scene[data-astro-cid-x]`
   * — a class plus an attribute — which ties with `.parent .scene` on
   * specificity and then wins on source order. An override from outside the
   * component silently does nothing. Ask the component instead.
   */
  maxWidth?: string;
}
const { chip, caption, id, class: className = '', maxWidth = '22rem' } = Astro.props;
const titleId = `rack-scene-${id}`;

/* ── QuietScene's weights and palette, deliberately. ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#CBD5E1';
const W_SUBJ = 2;
const W_FACE = 1.8;
const W_FINE = 1.4;

const GROUND = '#E3EAF3'; // the ground tone, and the one empty bay
const DEVICE = '#C9D9EC'; // the 404 rack's own blue — the cabinet
const KEYS = '#8FA8C8'; // the faces of the kit that fills a unit
const FUR = '#FFFFFF';
const FUR_SHADE = '#B9C4D2';
const LEAF_A = '#7DD87D';
const LEAF_B = '#4EB86B';
const POT = '#FCDCCF';
const GRASS = '#3FAE5F';
const MUG = '#F7B9A3';
const CLOUD = '#FFFFFF';
const GREEN = '#3FAE5F'; // the status lights, the 404 rack's LED colour
const ORANGE = '#F24E1E'; // the mug's band, and nothing else in this scene

/* QuietScene's cat, verbatim. */
const CAT_BODY = 'M180 128 C178 110 190 98 208 98 C226 98 242 106 244 128 Z';
const CAT_BACK =
  'M180 128 C178 110 190 98 208 98 C218 98 227 101 233 107 C214 104 192 112 186 128 Z';
const HEAD_SHADE = 'M226 110 C229 104 235 102 239 104 C233 105.5 228 108 226 113 Z';

/* ── The cabinet: 130 x 150 standing on the ground at 300, so x 159–289 and
      y 150–300. Four units inset to x 167–281, 26 tall, 4 apart, with 16 of
      clear cabinet above the first and 18 below the last. ── */
const U1 = 166; // patch panel
const U2 = 196; // switch
const U3 = 226; // THE SPARE ONE — the cat is in it
const U4 = 256; // blank filler

/* A row of ports as ONE path with rounded corners, not N <rect>s.
   Gate 1's curve ratio counts curved <path>s against EVERY drawn element, so
   thirteen port rectangles dragged the whole scene under the 40% floor at 35%.
   Drawn this way the same ports read identically and count as one curve each:
   45% with room to spare. The old RackScene used <pattern> tiles for the same
   reason — the measurement has always punished decorative rectangles. */
const portRow = (x0: number, y: number, n: number, w = 11, h = 9, gap = 6, r = 1.5) =>
  Array.from({ length: n }, (_, i) => {
    const x = x0 + i * (w + gap);
    return (
      `M${x + r} ${y} H${x + w - r} Q${x + w} ${y} ${x + w} ${y + r} ` +
      `V${y + h - r} Q${x + w} ${y + h} ${x + w - r} ${y + h} ` +
      `H${x + r} Q${x} ${y + h} ${x} ${y + h - r} ` +
      `V${y + r} Q${x} ${y} ${x + r} ${y} Z`
    );
  }).join(' ');
---

<figure class:list={['rack', className]} style={`--scene-max:${maxWidth}`}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    data-scene
    viewBox="33 55 380 275"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A server cabinet with four units. Three hold equipment; the fourth is empty, and a cat is
      curled up asleep inside it.
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ── Cloud: QuietScene's own, top left, as on every scene. Static
           parent, because the drift is animated. ── -->
      <g transform="translate(13 18)">
        <path
          class="cloud"
          d="M60 80 C55 80 54 71 61 69 C62 60 74 57 80 63 C86 56 99 59 100 68 C108 68 110 79 104 80 Z"
          fill={CLOUD}
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
      </g>

      <!-- ── Ground: the 404's own line and tone. The ellipse is drawn first so
           the cabinet stands ON it — Gate 0 overlap number two. ── -->
      <ellipse cx="224" cy="302" rx="100" ry="7" fill={GROUND} />
      <path d="M52 300 H394" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ══ THE CABINET — an object with cream on every side of it, which is
               the whole correction over the old version. ══ -->
      <rect
        x="159"
        y="150"
        width="130"
        height="150"
        rx="4"
        fill={DEVICE}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />
      <!-- mounting rails -->
      <g stroke={NAVY} stroke-width={W_FINE}>
        <path d={`M167 ${U1 - 4} V${U4 + 30}`} />
        <path d={`M281 ${U1 - 4} V${U4 + 30}`} />
      </g>
      <!-- corner screws, as on the company board -->
      <g fill={KEYS}>
        <circle cx="164" cy="155" r="1.5" />
        <circle cx="284" cy="155" r="1.5" />
        <circle cx="164" cy="295" r="1.5" />
        <circle cx="284" cy="295" r="1.5" />
      </g>

      <!-- unit 1 · patch panel: a face and a row of ports -->
      <rect x="167" y={U1} width="114" height="26" rx="2" fill={KEYS} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={portRow(182, U1 + 9, 4)} fill={DEVICE} stroke={NAVY} stroke-width={W_FINE} />

      <!-- unit 2 · switch: ports on the left, status lights on the right -->
      <rect x="167" y={U2} width="114" height="26" rx="2" fill={KEYS} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d={portRow(182, U2 + 9, 3)} fill={DEVICE} stroke={NAVY} stroke-width={W_FINE} />
      <g fill={GREEN}>
        <circle class="led led-1" cx="246" cy={U2 + 13} r="2.6" />
        <circle class="led led-2" cx="256" cy={U2 + 13} r="2.6" />
        <circle class="led led-3" cx="266" cy={U2 + 13} r="2.6" />
              </g>

      <!-- unit 3 · THE SPARE U. Filled with the ground tone so it reads as a
           recess you could slide something into, not a hole in the picture. -->
      <rect x="167" y={U3} width="114" height="26" rx="2" fill={GROUND} stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- unit 4 · blank filler: a face and its two thumbscrews -->
      <rect x="167" y={U4} width="114" height="26" rx="2" fill={KEYS} stroke={NAVY} stroke-width={W_SUBJ} />
      <g stroke={NAVY} stroke-width={W_FINE}>
        <path d={`M175 ${U4 + 13} H183`} />
        <path d={`M265 ${U4 + 13} H273`} />
      </g>

      <!-- ══ CAT — QuietScene's own drawing, curled in the spare U. Its base
               sits on that unit's floor at 252 and its EARS break the shelf
               above, which is what says "in" rather than "in front of". ══ -->
      <g transform="translate(10 124)">
        <path
          class="tail"
          d="M182 126 C170 128 164 120 170 113 C174 108 181 110 181 116"
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <!-- mis-registration: the back shading, laid inside and short of its contour -->
          <path d={CAT_BACK} fill={FUR_SHADE} />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
          <g stroke={ENVLINE} stroke-width={W_SUBJ}>
            <path d="M193 102 Q197 107 195 112" />
            <path d="M203 99.5 Q207 104 205 109" />
          </g>
        </g>
        <ellipse cx="213" cy="124.5" rx="8.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="head">
          <path d="M227.5 108 L228 96 L237 103.5 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d="M241 103.5 L248 97 L247.5 110 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <circle cx="236" cy="116" r="12" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <path d={HEAD_SHADE} fill={FUR_SHADE} />
          <!-- asleep: QuietScene's own closed, contented eyes -->
          <g stroke={NAVY} stroke-width={W_FACE}>
            <path d="M228 114 Q231 117 234 114" />
            <path d="M239 114 Q242 117 245 114" />
          </g>
          <path d="M236 119.5 L236 121" stroke={NAVY} stroke-width={W_FACE} />
          <g stroke={ENVLINE} stroke-width={W_FINE}>
            <path d="M227 119 L222.5 118" />
            <path d="M245 119 L249.5 118" />
          </g>
        </g>
      </g>

      <!-- ══ MUG — LEFT, between the grass and the cabinet ══ -->
      <g transform="translate(-8 8)">
        <g class="steam" stroke={ENVLINE} stroke-width={W_SUBJ}>
          <path class="wisp wisp-1" d="M103 262 C100 256 108 252 105 246" />
          <path class="wisp wisp-2" d="M112 262 C109 256 117 252 114 246" />
        </g>
        <path
          d="M96 268 L96 286 Q96 292 102 292 L114 292 Q120 292 120 286 L120 268 Z"
          fill={MUG}
          stroke={NAVY}
          stroke-width={W_SUBJ}
        />
        <rect x="97" y="278" width="22" height="5" fill={ORANGE} opacity="0.9" />
        <path d="M96 273 H120" stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M120 275 C130 275 130 287 120 287" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ PLANT — RIGHT, between the cabinet and the grass ══ -->
      <g transform="translate(11 8)">
        <g class="leaves">
          <path
            d="M330 274 C322 258 326 244 332 240 C338 246 338 262 330 274 Z"
            fill={LEAF_A}
            stroke={NAVY}
            stroke-width={W_SUBJ}
          />
          <path
            d="M330 274 C318 266 312 254 314 248 C322 250 330 262 330 274 Z"
            fill={LEAF_B}
            stroke={NAVY}
            stroke-width={W_SUBJ}
          />
          <path
            d="M330 274 C342 266 348 256 346 250 C338 252 331 263 330 274 Z"
            fill={LEAF_A}
            stroke={NAVY}
            stroke-width={W_SUBJ}
          />
        </g>
        <path d="M314 274 L318 292 H342 L346 274 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M312 274 H348" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <!-- ══ GRASS — both sides, as on the 404 ══ -->
      <g stroke={GRASS} stroke-width="3.5">
        <g class="grass grass-b">
          <path d="M62 300 C61 292 64 285 69 280" />
          <path d="M69 300 C69 292 71 286 75 282" />
          <path d="M75 300 C75 293 74 288 72 284" />
        </g>
        <g class="grass">
          <path d="M372 300 C371 292 374 285 379 280" />
          <path d="M379 300 C379 292 381 286 385 282" />
          <path d="M385 300 C385 293 384 288 382 284" />
        </g>
      </g>
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .rack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }
  .scene {
    display: block;
    width: 100%;
    /* the cap every scene carries, so one cat is one size wherever it appears.
       The hero raises it through the maxWidth prop; see the note on that prop
       for why an override from outside cannot work. */
    max-width: var(--scene-max, 22rem);
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The only motion that belongs to this scene: the switch is still doing its
       job while the cat sleeps in the bay under it. Everything else — breathing,
       the tail, the steam, the wind, the cloud — is shared and lives in
       src/styles/scene-motion.css. Nothing here duplicates it. */
    .led {
      animation: blink 3.2s steps(1, end) infinite;
    }
    .led-2 {
      animation-delay: 0.5s;
    }
    .led-3 {
      animation-delay: 1.1s;
    }
    @keyframes blink {
      0%,
      82% {
        opacity: 1;
      }
      86%,
      92% {
        opacity: 0.35;
      }
      96%,
      100% {
        opacity: 1;
      }
    }
  }
</style>
