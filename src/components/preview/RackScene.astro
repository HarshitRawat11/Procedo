---
/* ============================================================================
 *  RackScene — "Always leave room to grow." PREVIEW ONLY.
 *
 *  A close view of a rack face: a patch panel with its cables dressed away to
 *  both sides, a hank of spare cable tied to the rail, a switch with its status
 *  lights, a blank filler below — and in the one empty rack unit between them,
 *  the cat asleep. Every competent design leaves headroom. Something always
 *  moves into it.
 *
 *  Made for the home hero, which until now had a competency index card on the
 *  right and no artwork. The five links on that card are repeated as full cards
 *  in the section immediately below (ServicesPreview), so nothing is lost.
 *
 *  Built under reference/illustration-loop.md, technique B. All six countable
 *  Gate 1 checks pass: curve ratio 43%, spread 2.91, four load-bearing widths,
 *  nine stroke colours, 22% grid coordinates, 14 saturated fills.
 *
 *  The cat is a loaf: one long dome, a head at the right, two paws under the
 *  chin, a tail that drapes over the shelf and tapers. No legs are drawn — a
 *  loaf has none to get wrong, which is the whole reason the pose was chosen.
 *  The tail carries two rings, because without them a hanging tail reads as a
 *  hook; that fault has turned up in every scene on this site.
 *
 *  Mounting holes and patch ports are `<pattern>` tiles rather than 42 separate
 *  rects. That is not only tidier: it keeps the curve ratio honest, since the
 *  measurement script counts every drawn element.
 *
 *  Every animation sits inside prefers-reduced-motion: no-preference and every
 *  resting value lives on an attribute, so a reduced-motion visitor gets a
 *  complete still scene.
 * ========================================================================== */
interface Props {
  /** Small mono status label above the art, as on QuietScene. Omit for none. */
  chip?: string;
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — the pattern and title ids must not collide. */
  id: string;
  class?: string;
}
const { chip, caption, id, class: className = '' } = Astro.props;
const titleId = `rack-title-${id}`;
const holesId = `holes-${id}`;
const portsId = `ports-${id}`;

/* ── Contours ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#A8BACF';
const W_SUBJ = 2.6;
const W_ENV = 1.7;
const W_FINE = 1.1;
const W_CABLE = 3.2;

/* ── The rack ── */
const RAIL = '#C9D9EC';
const HOLE = '#8FA8C8';
const INTERIOR = '#EEF3F9';
const RECESS = '#E8EEF6';
const FACE = '#33415C'; // device faceplates
const FACE_DK = '#23304F'; // port and cage recesses
const FACE_LT = '#4A5B7C'; // a seam, and the velcro wraps
const LABEL = '#FFFFFF';

/* ── The cables. Every hue is already in use elsewhere on the site: no new
      colour was introduced for this scene. ── */
const C_BLUE = '#4A90D9';
const C_GREEN = '#4EB86B';
const C_GREEN_LT = '#7DD87D';
const C_PEACH = '#F7B9A3';
const C_GREY = '#8FA8C8';

/* ── The cat ── */
const FUR = '#FFFFFF';
const FUR_DK = '#B9C4D2';
const FUR_MARK = '#93A3B8';
const EAR_IN = '#FCDCCF';

/* The one hit of orange: one port on the switch wants looking at. */
const ORANGE = '#F24E1E';

/* Body filled, shaded off-register, then re-contoured (Gate 1 #1). */
const CAT_BODY =
  'M80 280 C80 234 102 204 148 198 C194 192 240 204 262 226 C274 240 278 260 278 280 Z';
const CAT_BACK =
  'M88 280 C88 238 108 210 150 204 C194 198 236 210 258 230 C238 216 200 210 158 216 C118 222 96 244 94 280 Z';
---

<figure class:list={['rack', className]}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    viewBox="0 0 360 420"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A close view of a server rack: a patch panel with cables dressed away to both sides, a switch
      with its status lights, and in the one empty rack unit between them, a cat curled up asleep
      with its tail draped over the shelf.
    </title>

    <defs>
      <pattern id={holesId} width="22" height="22" patternUnits="userSpaceOnUse">
        <rect x="6" y="8" width="7" height="7" rx="1.5" fill={HOLE} />
      </pattern>
      <pattern id={portsId} width="44" height="30" patternUnits="userSpaceOnUse">
        <rect x="8" y="6" width="26" height="17" rx="2" fill={FACE_DK} />
        <rect x="12" y="10" width="18" height="9" rx="1" fill={HOLE} />
      </pattern>
    </defs>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- the rack interior behind everything, cropped top and bottom -->
      <rect x="30" y="-10" width="300" height="440" fill={INTERIOR} />

      <!-- ══ the two uprights, cropped left and right ══ -->
      <rect x="-6" y="-10" width="36" height="440" fill={RAIL} stroke={NAVY} stroke-width={W_ENV} />
      <rect x="4" y="0" width="22" height="420" fill={`url(#${holesId})`} />
      <rect x="330" y="-10" width="36" height="440" fill={RAIL} stroke={NAVY} stroke-width={W_ENV} />
      <rect x="336" y="0" width="22" height="420" fill={`url(#${holesId})`} />

      <!-- ══ the underside of whatever is above, cropped by the top edge ══ -->
      <rect x="30" y="-24" width="300" height="38" fill={FACE} stroke={NAVY} stroke-width={W_ENV} />
      <circle cx="52" cy="6" r="3" fill={C_GREEN} />
      <circle cx="66" cy="6" r="3" fill={HOLE} />

      <!-- ══ PLANE 1: the patch panel ══
           mis-registration 1: the faceplate colour sits 3 right / 3 down of its
           own outline. Twelve ports, nine patched. -->
      <rect x="33" y="25" width="300" height="70" fill={FACE} />
      <rect x="30" y="22" width="300" height="70" fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
      <rect x="38" y="30" width="278" height="56" fill={`url(#${portsId})`} />
      <rect x="38" y="26" width="26" height="7" rx="1.5" fill={LABEL} stroke={ENVLINE} stroke-width={W_FINE} />
      <path d="M42 29.5 H60" stroke={ENVLINE} stroke-width={W_FINE} />

      <!-- ══ PLANE 2: the patch cables, dressed away to both sides. They pass
           over the uprights and over the lower ports — overlap one. ══ -->
      <path d="M197 44 C197 66 300 78 366 86" stroke={C_GREEN} stroke-width={W_CABLE} />
      <path d="M241 44 C241 70 306 88 366 96" stroke={C_PEACH} stroke-width={W_CABLE} />
      <path d="M65 74 C65 96 44 104 -6 108" stroke={C_BLUE} stroke-width={W_CABLE} />
      <path d="M109 74 C109 100 52 112 -6 118" stroke={C_GREEN} stroke-width={W_CABLE} />
      <path d="M153 74 C153 104 60 122 -6 130" stroke={C_GREEN_LT} stroke-width={W_CABLE} />
      <path d="M197 74 C197 108 68 132 -6 142" stroke={C_PEACH} stroke-width={W_CABLE} />
      <path d="M241 74 C241 100 288 106 366 112" stroke={C_GREY} stroke-width={W_CABLE} />
      <path d="M285 74 C285 102 302 120 366 128" stroke={C_BLUE} stroke-width={W_CABLE} />

      <!-- a hank of spare cable, coiled and tied to the left-hand rail -->
      <path d="M14 150 C2 150 2 178 14 178 C26 178 26 150 14 150 Z" stroke={C_BLUE} stroke-width={W_CABLE} />
      <path d="M14 157 C6 157 6 171 14 171 C22 171 22 157 14 157 Z" stroke={C_BLUE} stroke-width={W_CABLE} />
      <rect x="9" y="147" width="11" height="6" rx="1.5" fill={NAVY} />

      <!-- two velcro wraps, where each bundle is tightest -->
      <path d="M16 102 C10 114 9 126 12 138 C18 135 22 132 26 131 C24 121 26 112 29 104 Z" fill={FACE_LT} stroke={NAVY} stroke-width={W_FINE} />
      <path d="M340 100 C336 110 336 122 339 132 C344 130 348 128 352 128 C350 118 351 108 354 100 Z" fill={FACE_LT} stroke={NAVY} stroke-width={W_FINE} />

      <!-- ══ PLANE 3: the one empty rack unit ══
           mis-registration 2: the recess colour sits 3 right / 2 down of its
           outline. Labelled, like everything else here. -->
      <rect x="33" y="156" width="300" height="124" fill={RECESS} />
      <rect x="30" y="154" width="300" height="124" fill="none" stroke={NAVY} stroke-width={W_ENV} />
      <path d="M33 158 H327" stroke={ENVLINE} stroke-width={W_FINE} />

      <!-- ══ the shelf the cat is lying on ══ -->
      <rect x="26" y="280" width="308" height="12" rx="2" fill={RAIL} stroke={NAVY} stroke-width={W_ENV} />
      <rect x="288" y="282" width="26" height="7" rx="1.5" fill={LABEL} stroke={ENVLINE} stroke-width={W_FINE} />
      <path d="M292 285.5 H310" stroke={ENVLINE} stroke-width={W_FINE} />

      <!-- ══ PLANE 4: the switch, drawn before the cat so the tail falls over it ══ -->
      <rect x="30" y="296" width="300" height="56" fill={FACE} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M30 310 H330" stroke={FACE_LT} stroke-width={W_FINE} />
      <circle class="pip pip-1" cx="120" cy="303" r="2.6" fill={C_GREEN} />
      <circle class="pip pip-2" cx="134" cy="303" r="2.6" fill={C_GREEN} />
      <circle class="pip pip-3" cx="148" cy="303" r="2.6" fill={C_GREEN} />
      <circle cx="162" cy="303" r="2.6" fill={HOLE} />
      <!-- the one hit of orange: one port wants looking at -->
      <circle class="alert" cx="176" cy="303" r="2.6" fill={ORANGE} />
      <rect x="252" y="320" width="32" height="20" rx="2" fill={FACE_DK} stroke={HOLE} stroke-width={W_FINE} />
      <rect x="290" y="320" width="32" height="20" rx="2" fill={FACE_DK} stroke={HOLE} stroke-width={W_FINE} />
      <path d="M256 330 H280 M294 330 H318" stroke={HOLE} stroke-width={W_FINE} />

      <!-- ══ the blank filler below, cropped by the bottom edge ══ -->
      <rect x="30" y="358" width="300" height="70" fill={RAIL} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M64 372 H296 M64 382 H296 M64 392 H296 M64 402 H296 M64 412 H296" stroke={ENVLINE} stroke-width={W_ENV} />
      <circle cx="44" cy="392" r="4" fill={HOLE} stroke={NAVY} stroke-width={W_FINE} />
      <circle cx="316" cy="392" r="4" fill={HOLE} stroke={NAVY} stroke-width={W_FINE} />

      <!-- ══ PLANE 5: the cat, loafed in the empty unit ══ -->
      <path class="tail" d="M94 262 C72 260 52 272 48 296 C46 314 48 330 50 342 C54 340 57 336 58 330 C56 314 56 300 60 290 C66 278 84 274 98 276 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <g stroke={FUR_MARK} stroke-width={W_ENV}>
        <path d="M74 275 C77 281 77 287 74 293" />
        <path d="M88 276 C91 281 91 286 88 291" />
      </g>
      <g class="breathe">
        <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <!-- mis-registration 3: the back shading, 3 right / 2 down of its contour -->
        <path d={CAT_BACK} fill={FUR_DK} transform="translate(3 2)" />
        <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
        <!-- the tucked haunch, and three markings down the back -->
        <path d="M104 280 C100 258 108 238 124 226" stroke={FUR_MARK} stroke-width={W_ENV} />
        <g stroke={FUR_MARK} stroke-width={W_ENV}>
          <path d="M150 214 C156 224 155 238 150 248" />
          <path d="M186 210 C192 222 191 236 186 246" />
          <path d="M220 212 C226 222 225 234 220 242" />
        </g>
      </g>
      <!-- ears, set at different angles, each with its inner fold -->
      <path d="M250 210 L244 184 L268 198 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M253 205 C251 197 250 192 249 188 C255 192 259 196 263 199 C259 201 256 203 253 205 Z" fill={EAR_IN} />
      <path class="ear" d="M288 198 L308 180 L308 208 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M291 199 C295 194 299 190 303 186 C304 192 304 198 304 203 C300 201 295 200 291 199 Z" fill={EAR_IN} />
      <!-- head -->
      <path d="M239 234 C239 212 255 198 276 198 C297 198 313 212 313 234 C313 256 297 268 276 268 C255 268 239 256 239 234 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M243 226 C248 210 260 202 274 202 C258 207 248 215 245 228 Z" fill={FUR_DK} />
      <!-- eyes closed: asleep in the one unit nobody booked -->
      <g stroke={NAVY} stroke-width={W_ENV}>
        <path d="M254 234 C258 239 266 239 270 234" />
        <path d="M282 234 C286 239 294 239 298 234" />
      </g>
      <g stroke={NAVY} stroke-width={W_ENV}>
        <path d="M276 244 L276 247" />
        <path d="M271 250 Q276 254 281 250" />
      </g>
      <!-- the cheek, where the chin rests on the paws -->
      <path d="M243 246 C248 254 254 260 262 264" stroke={FUR_MARK} stroke-width={W_FINE} />
      <g stroke={ENVLINE} stroke-width={W_FINE}>
        <path d="M239 238 L224 234" />
        <path d="M239 244 L224 247" />
        <path d="M313 238 L328 235" />
        <path d="M313 243 L328 246" />
      </g>
      <!-- two paws under the chin, the near one further forward -->
      <path d="M252 280 C252 270 260 264 270 264 C280 264 288 270 288 280 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M218 280 C218 272 226 266 236 266 C246 266 254 272 254 280 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M264 280 C264 275 264 272 265 269 M276 280 C276 275 276 272 277 269" stroke={ENVLINE} stroke-width={W_FINE} />
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .rack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* the loaf rises and falls */
    .breathe {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: breathe 4.8s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,
      100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(1.025);
      }
    }

    /* the hanging tail swings from where it leaves the body */
    .tail {
      transform-box: fill-box;
      transform-origin: 92% 8%;
      animation: sway-tail 6.4s ease-in-out infinite;
    }
    @keyframes sway-tail {
      0%,
      100% {
        transform: rotate(-2deg);
      }
      50% {
        transform: rotate(2deg);
      }
    }

    /* the ear nearest the switch twitches now and then, but she does not wake */
    .ear {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: flick 9s ease-in-out infinite;
    }
    @keyframes flick {
      0%,
      86%,
      90%,
      94%,
      100% {
        transform: rotate(0deg);
      }
      88% {
        transform: rotate(-9deg);
      }
      92% {
        transform: rotate(-5deg);
      }
    }

    /* link and activity, at three different rates, because that is how a
       switch face actually behaves */
    .pip {
      animation: pip 2.4s steps(1, end) infinite;
    }
    .pip-2 {
      animation-duration: 1.1s;
    }
    .pip-3 {
      animation-duration: 3.7s;
    }
    @keyframes pip {
      0%,
      60% {
        opacity: 1;
      }
      61%,
      100% {
        opacity: 0.35;
      }
    }

    /* the one amber port, breathing slower than the rest */
    .alert {
      animation: alert 3.2s ease-in-out infinite;
    }
    @keyframes alert {
      0%,
      100% {
        opacity: 0.45;
      }
      50% {
        opacity: 1;
      }
    }
  }
</style>
