---
/* ============================================================================
 *  ReceptionScene — the cat asleep on the front desk, the call finished.
 *
 *  WHERE IT IS USED: the contact form's success card, and nowhere else.
 *  Harshit's call on 2026-09-13 — the three placement options were dropped and
 *  the image now appears only once the visitor has actually sent something.
 *
 *  ── REBUILT 2026-09-13, second pass ─────────────────────────────────────────
 *  The first pass fixed the emptiness and left the objects loud. Harshit:
 *  *"see the 404 every component is minisized and not loud. in the contact the
 *  cat is too big and even the plant is also big. due to this you have to make
 *  desk and phone big. colouring and design of the cat on the 404 and contact
 *  is different too make them same."* All three points were right.
 *
 *  · THE CAT IS NOW THE 404 CAT. Not a lookalike — the same paths, lifted from
 *    QuietScene and moved onto the desk with one translate. Same circle head,
 *    same closed eyes, same single whisker each side, same tucked-paw ellipse,
 *    same open-stroke tail, and the markings back to the pale `#CBD5E1` they
 *    are there rather than the darker `#93A3B8` this scene had drifted to. Two
 *    pages, one cat.
 *
 *  · THE CANVAS IS 420 WIDE, exactly as QuietScene's is. This is the part that
 *    actually governs how big the cat *looks*: apparent size is the cat's width
 *    divided by the CANVAS width, not by anything in the drawing. Both cats are
 *    85.5 units on a 420 canvas — 20.4% — so at the same rendered width they
 *    are the same size on screen. The earlier pass had the same cat in units
 *    but on a 292-wide canvas, which drew it half again as large.
 *
 *  · EVERYTHING ELSE SHRANK TO SUIT. The desk is 174 units against the 404
 *    rack's 152; the phone is at mug scale; the plant and the grass tufts are
 *    QuietScene's own, unscaled.
 *
 *  Gate 1b: 90.4% bare cream, 2.0% dark, against floors of 60% and 5%. The
 *  benchmark is 80.9% and 3.4%, so this sits a shade quieter still.
 *  Gate 1: curve ratio 44%, spread 2.5, four widths, 23% grid coordinates.
 *      node scripts/measure-density.cjs <file.svg>
 *
 *  WHAT WENT, and it was working code: the `oncall` state and the twelve-second
 *  ring-and-pickup loop. That animation needed an articulated paw to grip the
 *  handset and a body big enough to hold it at the ear. This cat has a tucked
 *  paw ellipse eight units across and is asleep. The two cannot coexist, and
 *  the loop had no caller left anyway — the success card only ever showed the
 *  hung-up still. It is in git at b3386c4 if it is ever wanted back.
 * ========================================================================== */
interface Props {
  /** Small mono status label above the art, as on QuietScene. Omit for none. */
  chip?: string;
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — the title id must not collide. */
  id: string;
  class?: string;
}
const { chip, caption, id, class: className = '' } = Astro.props;
const titleId = `reception-title-${id}`;

/* ── Weights and colours are QuietScene's, deliberately. Where a value below
      looks oddly specific it is because it is copied, not chosen. ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#CBD5E1';
const W_SUBJ = 2;
const W_FACE = 1.8;
const W_FINE = 1.4;

const TIMBER = '#E4CBA8';
const GROUND = '#E3EAF3';
const DEVICE = '#C9D9EC'; // the 404 rack's own blue
const DEVICE_DK = '#8FA8C8';
const CUSHION = '#FCDCCF';
const FUR = '#FFFFFF';
const FUR_SHADE = '#B9C4D2';
const LEAF_A = '#7DD87D';
const LEAF_B = '#4EB86B';
const POT = '#FCDCCF';
const GRASS = '#3FAE5F';

/* The one hit of orange: a message waiting, which is what you just left. */
const ORANGE = '#F24E1E';

/* QuietScene's cat, verbatim. Body, the off-register back shading, and the
   head shade — the three shapes that give it its particular softness. */
const CAT_BODY = 'M180 128 C178 110 190 98 208 98 C226 98 242 106 244 128 Z';
const CAT_BACK =
  'M180 128 C178 110 190 98 208 98 C218 98 227 101 233 107 C214 104 192 112 186 128 Z';
const HEAD_SHADE = 'M226 110 C229 104 235 102 239 104 C233 105.5 228 108 226 113 Z';
---

<figure class:list={['reception', className]}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    viewBox="0 134 420 240"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A cat curled up asleep on a desk beside a telephone, its handset back on the cradle and the
      message light lit.
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ── Ground: the 404 scene's own line and tone ── -->
      <ellipse cx="224" cy="302" rx="100" ry="7" fill={GROUND} />
      <path d="M128 300 H322" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ── The desk: 174 units, where the 404 rack is 152. mis-registration 1:
           the timber colour sits 3 right / 2 down of its own outline. ── -->
      <rect x="141" y="238" width="174" height="10" rx="2" fill={TIMBER} />
      <rect x="138" y="236" width="174" height="10" rx="2" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M150 246 V300" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M298 246 V300" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M150 286 H298" stroke={ENVLINE} stroke-width={W_SUBJ} />

      <!-- ── The telephone, at the 404 mug's scale. The handset sits up on two
           cradle nubs so daylight shows under it — that is what reads as a
           telephone at this size, not detail. ── -->
      <rect x="252" y="232" width="46" height="14" rx="3" fill={DEVICE} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M258 232 V227 M292 232 V227" stroke={NAVY} stroke-width={W_SUBJ} />
      <g fill={DEVICE_DK}>
        <rect x="258" y="237" width="7" height="4" rx="1" />
        <rect x="268" y="237" width="7" height="4" rx="1" />
        <rect x="278" y="237" width="7" height="4" rx="1" />
      </g>
      <circle cx="291" cy="239" r="2.5" fill={ORANGE} />
      <path class="cord" d="M300 224 c8 0 12 5 9 9 c-3 4 1 8 5 10 c4 2 5 7 2 11" stroke={ENVLINE} stroke-width={W_SUBJ} />
      <rect x="250" y="219" width="50" height="9" rx="4.5" fill={DEVICE_DK} stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- ── The cat: QuietScene's own drawing, moved onto the desk by one
           translate. Same paths, same weights, same closed eyes, same pale
           markings — so the two pages carry one cat, not two. ── -->
      <ellipse cx="198" cy="238" rx="40" ry="8" fill={CUSHION} />
      <g transform="translate(-14 108)">
        <path class="tail" d="M182 126 C170 128 164 120 170 113 C174 108 181 110 181 116" stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <!-- mis-registration 2: the back shading, laid inside and short of its contour -->
          <path d={CAT_BACK} fill={FUR_SHADE} />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
          <g stroke={ENVLINE} stroke-width={W_SUBJ}>
            <path d="M193 102 Q197 107 195 112" />
            <path d="M203 99.5 Q207 104 205 109" />
          </g>
        </g>
        <ellipse cx="213" cy="124.5" rx="8.5" ry="3.5" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M227.5 108 L228 96 L237 103.5 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M241 103.5 L248 97 L247.5 110 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <circle cx="236" cy="116" r="12" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d={HEAD_SHADE} fill={FUR_SHADE} />
        <path d="M228 114 Q231 117 234 114" stroke={NAVY} stroke-width={W_FACE} />
        <path d="M239 114 Q242 117 245 114" stroke={NAVY} stroke-width={W_FACE} />
        <path d="M236 119.5 L236 121" stroke={NAVY} stroke-width={W_FACE} />
        <g stroke={ENVLINE} stroke-width={W_FINE}>
          <path d="M227 119 L222.5 118" />
          <path d="M245 119 L249.5 118" />
        </g>
      </g>

      <!-- ── The plant: QuietScene's own, unscaled, beside the desk ── -->
      <g class="leaves" transform="translate(-206 8)">
        <path d="M330 274 C322 258 326 244 332 240 C338 246 338 262 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M330 274 C318 266 312 254 314 248 C322 250 330 262 330 274 Z" fill={LEAF_B} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M330 274 C342 266 348 256 346 250 C338 252 331 263 330 274 Z" fill={LEAF_A} stroke={NAVY} stroke-width={W_SUBJ} />
      </g>
      <path d="M108 282 L112 300 H136 L140 282 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M106 282 H142" stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- ── Grass both sides, as on the 404 scene, so the ground is not a bare line ── -->
      <g stroke={GRASS} stroke-width="3.5">
        <g class="grass grass-b">
          <path d="M92 300 C91 292 94 285 99 280" />
          <path d="M99 300 C99 292 101 286 105 282" />
          <path d="M105 300 C105 293 104 288 102 284" />
        </g>
        <g class="grass">
          <path d="M308 300 C307 292 310 285 315 280" />
          <path d="M315 300 C315 292 317 286 321 282" />
          <path d="M321 300 C321 293 320 288 318 284" />
        </g>
      </g>
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .reception {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  /* The timings are QuietScene's as well — the two scenes should not only look
     alike, they should move alike. */
  @media (prefers-reduced-motion: no-preference) {
    .breathe {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: breathe 4.5s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,
      100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(1.04);
      }
    }

    .tail {
      transform-box: fill-box;
      transform-origin: 100% 60%;
      animation: tail 9s ease-in-out infinite;
    }
    @keyframes tail {
      0%,
      80%,
      100% {
        transform: rotate(0deg);
      }
      87% {
        transform: rotate(-8deg);
      }
      93% {
        transform: rotate(4deg);
      }
    }

    .leaves {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: sway 6s ease-in-out infinite;
    }
    .grass {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: sway 5s ease-in-out infinite;
    }
    .grass-b {
      animation-duration: 6.5s;
      animation-delay: -2s;
    }
    @keyframes sway {
      0%,
      100% {
        transform: rotate(-2.5deg);
      }
      50% {
        transform: rotate(2.5deg);
      }
    }
  }
</style>
