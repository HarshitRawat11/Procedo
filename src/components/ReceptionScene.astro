---
/* ============================================================================
 *  ReceptionScene — the cat at the front desk, answering the phone.
 *
 *  WHERE IT IS USED: the contact form's success card, and nowhere else.
 *  Harshit's call on 2026-09-13 — the three placement options were dropped and
 *  the image now appears only once the visitor has actually sent something.
 *  The form renders it in `state="hungup"`: handset back on the cradle, line
 *  light out, call sequence stopped. The call is over because you just made it.
 *
 *  ── REFINED 2026-09-13 against Gate 1b ──────────────────────────────────────
 *  Harshit put this beside the 404 illustration: that one's elements are
 *  subtle, this one's were large and bold. Measured, the difference was how
 *  much of the frame each leaves alone — 80.9% bare cream on the 404 scene
 *  against 41.3% here. What changed:
 *
 *    · The full-width reception counter became a DESK: an object that ends
 *      inside the frame, with cream either side and a drawer unit anchoring it.
 *      A counter running edge to edge is a backdrop, not a prop.
 *    · The wall went — notice board, clock, visitor book and pen pot with it.
 *      Four props gone, and the two biggest slabs among them.
 *    · Nothing is dark any more. The phone and handset carry their weight in
 *      the outline, not the fill; `#33415C` faceplates are gone.
 *    · Contours thinned to the 404 scene's own values: subject 2.0 (was 2.6),
 *      environment 1.4 (was 1.7), fine 1.0 (was 1.1), and the environment
 *      colour palest `#CBD5E1` rather than `#A8BACF`.
 *
 *  Result: 76.2% bare cream, 3.2% dark, against floors of 60% and 5%. The 404
 *  benchmark scores 80.9% and 3.4%. Run it yourself:
 *      node scripts/measure-density.cjs <file.svg>
 *
 *  All six countable Gate 1 checks pass too: curve ratio 48%, spread 2.0,
 *  three load-bearing widths, six stroke colours, 20% grid coordinates.
 *
 *  How the pickup is rigged: the handset and the paw that holds it share one
 *  group, `.rig`, so they travel together. `.grip` moves the paw between the
 *  desk and the handset only while the rig is parked on the cradle; `.rattle`
 *  shakes the handset alone. The cord is anchored at the phone and rotated +
 *  stretched to the handset's plug; its keyframes are re-derived from the rig's
 *  own path, so the two cannot drift apart. Every resting value is an
 *  attribute; the CSS only ever overrides.
 * ========================================================================== */
interface Props {
  /** Small mono status label above the art, as on QuietScene. Omit for none. */
  chip?: string;
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — the title id must not collide. */
  id: string;
  class?: string;
  /**
   * `oncall` is the handset at the ear — the resting pose, and the state the
   * twelve-second loop returns to. `hungup` parks the handset on its cradle,
   * the paw on the desk and the line light out, and stops the whole call
   * sequence; the cat still breathes, the tail still sways. The contact form
   * uses `hungup`: the call is over because you just made it.
   */
  state?: 'oncall' | 'hungup';
}
const { chip, caption, id, class: className = '', state = 'oncall' } = Astro.props;
const titleId = `reception-title-${id}`;
const hungup = state === 'hungup';

/* ── Contours: the 404 scene's weights, not the heavier set this scene had ── */
const NAVY = '#1B2A4A';
const ENVLINE = '#CBD5E1';
const W_SUBJ = 2;
const W_ENV = 1.4;
const W_FINE = 1;

/* ── The desk ── */
const TIMBER = '#E4CBA8';
const TIMBER_DK = '#C9A87C';
const CARCASS = '#EEF3F9';
const HANDLE = '#8FA8C8';
const FLOOR = '#EEF3F9';

/* ── The telephone. Mid-tone, so the outline carries the weight. ── */
const PHONE = '#8FA8C8';
const HANDSET_C = '#6E88AB';
const KEYS = '#E8EEF6';
const NUB = '#C9D9EC';

/* ── The cat and the plant ── */
const FUR = '#FFFFFF';
const FUR_DK = '#B9C4D2';
const FUR_MARK = '#93A3B8';
const LEAF = '#4EB86B';
const LEAF_LT = '#7DD87D';
const POT = '#FCDCCF';

/* The one hit of orange: the in-use light on the phone. */
const ORANGE = '#F24E1E';

/* The cat is WorkshopScene's crouch, drawn in its own coordinates and mirrored
   by the group transform: x = 586 - x0, y = y0 - 16. Body filled, shaded
   off-register, then re-contoured (Gate 1). */
const CAT_BODY =
  'M178 262 C176 232 186 208 206 206 C228 204 250 216 268 228 C276 234 280 246 280 262 Z';
const CAT_BACK =
  'M186 262 C184 236 194 214 212 212 C234 210 254 220 268 232 C252 222 232 218 214 220 C198 222 190 240 190 262 Z';
/* Tallest leaf, filled off-register. */
const LEAF_BIG = 'M172 302 C164 290 165 276 172 270 C179 276 180 290 172 302 Z';
/* The handset, centred on its own origin so the rig can rotate it in place. */
const HANDSET =
  'M-6 -19 C-6 -22 -3 -24 0 -24 C3 -24 6 -22 6 -19 L6 -13 C6 -11 4.5 -10.5 3 -10 L3 10 C4.5 10.5 6 11 6 13 L6 19 C6 22 3 24 0 24 C-3 24 -6 22 -6 19 L-6 13 C-6 11 -4.5 10.5 -3 10 L-3 -10 C-4.5 -10.5 -6 -11 -6 -13 Z';

/* Resting transforms per state. These are the same values the keyframes use at
   0% (oncall) and 38–79% (hungup), so the still and the loop cannot disagree.
   The cord values are derived from the rig's own path — see the note above. */
const REST = {
  oncall: {
    rig: 'translate(266 212) rotate(-30)',
    grip: 'translate(-2 18)',
    cord: 'translate(240 236) rotate(-4.84) scale(1.1243 1)',
  },
  hungup: {
    rig: 'translate(226 212) rotate(-90)',
    grip: 'translate(-24 48) rotate(90)',
    cord: 'translate(240 236) rotate(-67.38) scale(0.7665 1)',
  },
}[state];
---

<figure class:list={['reception', hungup && 'hungup', className]}>
  {
    chip && (
      <p class="chip">
        <span class="chip-dot" aria-hidden="true" />
        {chip}
      </p>
    )
  }

  <svg
    class="scene"
    viewBox="110 140 380 260"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      {
        hungup
          ? 'A cat sitting on a desk beside a telephone, the handset back on its cradle and the call finished.'
          : 'A cat sitting on a desk with a telephone handset held to its ear, the coiled cord trailing back to the phone beside it.'
      }
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ══ the ground: a soft shadow and a short line, as on the 404 scene.
           Nothing spans the frame. ══ -->
      <ellipse cx="310" cy="334" rx="132" ry="7" fill={FLOOR} />
      <path d="M186 334 H436" stroke={ENVLINE} stroke-width={W_ENV} />

      <!-- ══ the desk — an object, not a counter. mis-registration 1: the
           timber colour sits 3 right / 2 down of its own outline. ══ -->
      <rect x="175" y="248" width="270" height="11" rx="2.5" fill={TIMBER} />
      <rect x="172" y="246" width="270" height="11" rx="2.5" stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M190 251.5 C240 250 300 253 360 251 C400 250 420 252 434 251" stroke={TIMBER_DK} stroke-width={W_FINE} />
      <rect x="188" y="259" width="62" height="73" rx="2" fill={CARCASS} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M188 283 H250 M188 307 H250" stroke={ENVLINE} stroke-width={W_ENV} />
      <path d="M210 271 H228 M210 295 H228 M210 319 H228" stroke={HANDLE} stroke-width={W_SUBJ} />
      <rect x="410" y="259" width="10" height="73" rx="1.5" fill={CARCASS} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M250 316 H410" stroke={ENVLINE} stroke-width={W_ENV} />

      <!-- ══ the phone — the weight is in the outline, not the fill ══ -->
      <path d="M204 222 C204 216 213 216 213 222 Z" fill={NUB} stroke={NAVY} stroke-width={W_FINE} />
      <path d="M228 222 C228 216 237 216 237 222 Z" fill={NUB} stroke={NAVY} stroke-width={W_FINE} />
      <rect x="184" y="222" width="56" height="24" rx="4" fill={PHONE} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M191 229 h8 v5 h-8 Z M203 229 h8 v5 h-8 Z M215 229 h8 v5 h-8 Z M191 237 h8 v5 h-8 Z M203 237 h8 v5 h-8 Z M215 237 h8 v5 h-8 Z" fill={KEYS} />
      <circle cx="232" cy="232" r="2.6" fill={NUB} />
      <circle class="inuse" cx="232" cy="232" r="2.6" fill={ORANGE} opacity={hungup ? 0 : 1} />

      <!-- the coiled cord, drawn before the cat so the paw sits in front of it -->
      <g class="cord" transform={REST.cord}>
        <path d="M0 0 c2.12 -7 6.36 7 8.48 0 c2.12 -7 6.36 7 8.48 0 c2.12 -7 6.36 7 8.48 0 c2.12 -7 6.36 7 8.48 0" stroke={ENVLINE} stroke-width={W_ENV} />
      </g>

      <!-- ══ a small plant, at the scale the 404 scene uses. It overlaps the
           desk, which is the depth Gate 0 asks for. ══ -->
      <path d={LEAF_BIG} fill={LEAF_LT} transform="translate(-2 1)" />
      <path d={LEAF_BIG} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M172 302 C160 296 152 284 154 276 C164 280 171 292 172 302 Z" fill={LEAF} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M172 302 C184 296 191 286 189 278 C180 282 173 292 172 302 Z" fill={LEAF} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M158 304 L162 332 L182 332 L186 304 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M156 304 H188" stroke={NAVY} stroke-width={W_SUBJ} />

      <!-- ══ the cat — the workshop crouch, mirrored to face the phone ══ -->
      <g transform="translate(586 -16) scale(-1 1)">
        <path class="tail" d="M184 248 C168 240 156 222 162 204 C166 192 180 190 186 200 C180 202 176 208 178 216 C180 228 190 238 196 246 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <g class="breathe">
          <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
          <!-- mis-registration 2: the back shading, 3 right / 2 down of its contour -->
          <path d={CAT_BACK} fill={FUR_DK} transform="translate(3 2)" />
          <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
          <g stroke={FUR_MARK} stroke-width={W_ENV}>
            <path d="M212 224 C217 232 216 242 212 248" />
            <path d="M236 226 C241 234 240 244 236 249" />
          </g>
        </g>
        <path d="M278 216 L274 196 L292 208 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path class="ear" d="M300 208 L318 194 L316 216 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M272 232 C272 219 282 210 294 210 C306 210 316 219 316 232 C316 245 306 254 294 254 C282 254 272 245 272 232 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d="M275 224 C279 214 288 210 298 211 C287 214 279 220 276 229 Z" fill={FUR_DK} />
        <path d="M282 230 C285 226 291 226 294 230 C291 234 285 234 282 230 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
        <circle cx="291" cy="232" r="2" fill={NAVY} />
        <path d="M298 230 C301 226 307 226 310 230 C307 234 301 234 298 230 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
        <circle cx="307" cy="232" r="2" fill={NAVY} />
        <g stroke={NAVY} stroke-width={W_ENV}>
          <path d="M297 239 L297 241" />
          <path d="M293 244 Q297 247 301 244" />
        </g>
        <g stroke={ENVLINE} stroke-width={W_FINE}>
          <path d="M270 236 L257 233" />
          <path d="M270 242 L257 244" />
          <path d="M318 236 L328 234" />
          <path d="M318 241 L328 243" />
        </g>
        <!-- the far forepaw, planted -->
        <path d="M286 254 C290 250 298 250 302 254 C304 258 300 262 294 262 C287 262 283 258 286 254 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
      </g>

      <!-- ══ the handset and the paw that holds it ══ -->
      <g class="rig" transform={REST.rig}>
        <g class="rattle">
          <path d={HANDSET} fill={HANDSET_C} stroke={NAVY} stroke-width={W_ENV} />
          <circle cx="-2" cy="-18" r="1.1" fill={KEYS} />
          <circle cx="2" cy="-18" r="1.1" fill={KEYS} />
          <circle cx="0" cy="-14.5" r="1.1" fill={KEYS} />
          <path d="M-3 19 C-3 21 3 21 3 19" stroke={KEYS} stroke-width={W_FINE} />
        </g>
        <g class="grip" transform={REST.grip}>
          <path d="M10 -3 C6 -8 -4 -8 -10 -4 C-13 1 -8 7 0 7 C8 7 13 2 10 -3 Z" fill={FUR} stroke={NAVY} stroke-width={W_ENV} />
        </g>
      </g>

      <!-- the ring, either side of the cradled handset; hidden while the call is on -->
      <g class="ring" opacity="0" stroke={ENVLINE} stroke-width={W_ENV}>
        <path d="M197 205 C192 208.5 192 215.5 197 219" />
        <path d="M191 201 C184 206 184 218 191 223" />
        <path d="M254 205 C259 208.5 259 215.5 254 219" />
        <path d="M259 202 C265 206 265 218 259 222" />
      </g>

      <!-- a voice coming out of the earpiece -->
      <g class="voice" stroke={ENVLINE} stroke-width={W_FINE} opacity={hungup ? 0 : 1}>
        <path d="M250 180 C244 184 244 192 250 196" />
        <path d="M243 174 C235 181 235 195 243 202" />
      </g>
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .reception {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy-700);
  }
  .chip-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
  }
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The hung-up state is a still: the call sequence is off, and only the
       ambient life — breathing, tail, leaves — keeps running. */
    .reception.hungup .rig,
    .reception.hungup .grip,
    .reception.hungup .cord,
    .reception.hungup .rattle,
    .reception.hungup .ring,
    .reception.hungup .inuse,
    .reception.hungup .voice,
    .reception.hungup .ear {
      animation: none;
    }

    /* ── The call: one twelve-second loop ──
       0–30 talking · 30–38 hang up · 38–42 paw off the handset · 42–55 quiet ·
       55–62 ring · 62–65 · 65–72 ring · 72–75 · 75–79 reach · 79–87 lift ·
       87–100 talking. Everything runs on this one clock so it cannot drift. */
    .rig,
    .grip,
    .cord,
    .rattle {
      transform-box: view-box;
      transform-origin: 0 0;
    }

    /* handset + holding paw: ear ↔ cradle */
    .rig {
      animation: rig 12s ease-in-out infinite;
    }
    @keyframes rig {
      0%,
      30% {
        transform: translate(266px, 212px) rotate(-30deg);
      }
      38%,
      79% {
        transform: translate(226px, 212px) rotate(-90deg);
      }
      87%,
      100% {
        transform: translate(266px, 212px) rotate(-30deg);
      }
    }

    /* the paw lets go onto the desk, and later reaches back for the handset.
       Both moves happen while the rig is parked, so the desk position is fixed
       in rig coordinates: world (274, 236) = rig (-24, 48) at rotate -90. */
    .grip {
      animation: grip 12s ease-in-out infinite;
    }
    @keyframes grip {
      0%,
      38% {
        transform: translate(-2px, 18px) rotate(0deg);
      }
      42%,
      75% {
        transform: translate(-24px, 48px) rotate(90deg);
      }
      79%,
      100% {
        transform: translate(-2px, 18px) rotate(0deg);
      }
    }

    /* the cord swings from its anchor and stretches to the plug. Every middle
       keyframe is the plug's true position at 1/4, 1/2 and 3/4 of the rig's
       ease-in-out, re-derived after the handset was re-angled to -30deg. */
    .cord {
      animation: cord 12s linear infinite;
    }
    @keyframes cord {
      0%,
      30% {
        transform: translate(240px, 236px) rotate(-4.84deg) scale(1.1243, 1);
      }
      32% {
        transform: translate(240px, 236px) rotate(-8.04deg) scale(1.0579, 1);
      }
      34% {
        transform: translate(240px, 236px) rotate(-24.13deg) scale(0.8653, 1);
      }
      36% {
        transform: translate(240px, 236px) rotate(-54.27deg) scale(0.7542, 1);
      }
      38%,
      79% {
        transform: translate(240px, 236px) rotate(-67.38deg) scale(0.7665, 1);
      }
      81% {
        transform: translate(240px, 236px) rotate(-54.27deg) scale(0.7542, 1);
      }
      83% {
        transform: translate(240px, 236px) rotate(-24.13deg) scale(0.8653, 1);
      }
      85% {
        transform: translate(240px, 236px) rotate(-8.04deg) scale(1.0579, 1);
      }
      87%,
      100% {
        transform: translate(240px, 236px) rotate(-4.84deg) scale(1.1243, 1);
      }
    }

    /* the handset rattles in its cradle, two bursts, about four times a second */
    .rattle {
      animation: rattle 12s linear infinite;
    }
    @keyframes rattle {
      0%,
      55%,
      62%,
      65%,
      72%,
      100% {
        transform: rotate(0deg);
      }
      56%,
      58%,
      60%,
      66%,
      68%,
      70% {
        transform: rotate(4deg);
      }
      57%,
      59%,
      61%,
      67%,
      69%,
      71% {
        transform: rotate(-4deg);
      }
    }

    /* arcs either side of the handset, on for each burst */
    .ring {
      animation: ring 12s steps(1, end) infinite;
    }
    @keyframes ring {
      0%,
      62%,
      72%,
      100% {
        opacity: 0;
      }
      55%,
      65% {
        opacity: 1;
      }
    }

    /* the in-use light: on through the call, off on the hook, on with each ring */
    .inuse {
      animation: inuse 12s steps(1, end) infinite;
    }
    @keyframes inuse {
      0%,
      55%,
      65%,
      79%,
      100% {
        opacity: 1;
      }
      38%,
      62%,
      72% {
        opacity: 0;
      }
    }

    /* the caller's voice pulses while the handset is up */
    .voice {
      animation: voice 12s ease-in-out infinite;
    }
    @keyframes voice {
      0%,
      8%,
      16%,
      24%,
      94%,
      100% {
        opacity: 1;
      }
      4%,
      12%,
      20% {
        opacity: 0.25;
      }
      28%,
      90% {
        opacity: 0;
      }
    }

    /* the near ear flicks towards the phone as each burst begins. The group is
       mirrored, so a positive angle here tips the ear left on screen. */
    .ear {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: flick 12s ease-in-out infinite;
    }
    @keyframes flick {
      0%,
      55%,
      57%,
      59%,
      65%,
      67%,
      100% {
        transform: rotate(0deg);
      }
      56% {
        transform: rotate(14deg);
      }
      58% {
        transform: rotate(9deg);
      }
      66% {
        transform: rotate(12deg);
      }
    }

    .breathe {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: breathe 4.6s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,
      100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(1.03);
      }
    }

    /* the raised tail sways from its root */
    .tail {
      transform-box: fill-box;
      transform-origin: 90% 95%;
      animation: sway-tail 5.2s ease-in-out infinite;
    }
    @keyframes sway-tail {
      0%,
      100% {
        transform: rotate(-3deg);
      }
      50% {
        transform: rotate(3deg);
      }
    }
  }
</style>
