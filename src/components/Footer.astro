---
// Light footer (band surface so the navy+orange logo reads correctly): brand +
// tagline + socials, three link columns, tap-to-contact block.
import Container from './Container.astro';
import Logo from './Logo.astro';
import { Icon } from 'astro-icon/components';
import { site, contact, socials, footer } from '../data/site';

const year = 2026;
const telHref = 'tel:' + contact.phone.replace(/[^+\d]/g, '');
// Only render social icons that point somewhere real (placeholders are '#').
const liveSocials = socials.filter((s) => s.href && s.href !== '#');
---

<footer class="border-t border-line bg-band text-ink-600">
  <Container class="py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <Logo href="/" />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-600">{footer.tagline}</p>
        {
          liveSocials.length > 0 && (
            <div class="mt-6 flex items-center gap-2">
              {liveSocials.map((s) => (
                <a
                  href={s.href}
                  aria-label={s.label}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid size-9 place-items-center rounded-lg border border-line bg-white text-ink-500 transition-colors hover:border-brand-300 hover:text-brand-700"
                >
                  <Icon name={s.icon} class="size-4" aria-hidden="true" />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <!-- Link columns -->
      {
        footer.columns.map((col) => (
          <div class="lg:col-span-2">
            <h2 class="font-mono text-xs uppercase tracking-wider text-navy-900">{col.title}</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-ink-600 transition-colors hover:text-brand-700">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Contact -->
      <div class="lg:col-span-2">
        <h2 class="font-mono text-xs uppercase tracking-wider text-navy-900">Get in touch</h2>
        <div class="mt-4 space-y-3 text-sm">
          <a
            href={`mailto:${contact.email}`}
            class="flex items-start gap-2.5 text-ink-600 transition-colors hover:text-brand-700"
          >
            <Icon
              name="lucide:mail"
              class="mt-0.5 size-4 shrink-0 text-brand-500"
              aria-hidden="true"
            />
            <span class="break-all">{contact.email}</span>
          </a>
          <a
            href={`mailto:${contact.salesEmail}`}
            class="flex items-start gap-2.5 text-ink-600 transition-colors hover:text-brand-700"
          >
            <Icon
              name="lucide:briefcase"
              class="mt-0.5 size-4 shrink-0 text-brand-500"
              aria-hidden="true"
            />
            <span class="break-all">{contact.salesEmail}</span>
          </a>
          <a
            href={telHref}
            class="flex items-start gap-2.5 text-ink-600 transition-colors hover:text-brand-700"
          >
            <Icon
              name="lucide:phone"
              class="mt-0.5 size-4 shrink-0 text-brand-500"
              aria-hidden="true"
            />
            <span>{contact.phone}</span>
          </a>
          {
            contact.address && (
              <p class="flex items-start gap-2.5 text-ink-600">
                <Icon
                  name="lucide:map-pin"
                  class="mt-0.5 size-4 shrink-0 text-brand-500"
                  aria-hidden="true"
                />
                <span>{contact.address}</span>
              </p>
            )
          }
        </div>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-line pt-7 text-sm text-ink-600 sm:flex-row"
    >
      {/*
        `legalName` ends in "Pvt. Ltd." — a full stop of its own — so appending
        another produced "Pvt. Ltd.. All rights reserved." on every page of the
        site. Strip one trailing stop rather than dropping the period from the
        name, which is part of the registered name and is correct everywhere
        else it appears.
      */}
      <p>© {year} {site.legalName.replace(/\.$/, '')}. All rights reserved.</p>
      <nav aria-label="Legal" class="flex items-center gap-5">
        <a href="/privacy" class="transition-colors hover:text-navy-900">Privacy</a>
        <a href="/terms" class="transition-colors hover:text-navy-900">Terms</a>
        <a href="/cookies" class="transition-colors hover:text-navy-900">Cookies</a>
      </nav>
    </div>
  </Container>
</footer>
