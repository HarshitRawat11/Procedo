---
/* ============================================================================
 *  DeskScene — "The seat is taken, temporarily".
 *
 *  Live on the Careers page, inside the open-application card.
 *
 *  A cat asleep, curled on an office chair beside a lit desk. The monitor is
 *  still on and the mug is still warm — it is the seat a candidate would be
 *  taking. Drawn for the Careers page, the only content page with no artwork.
 *
 *  Technique B, matching the rest of the site: navy contours with flat colour
 *  laid in underneath. Built under reference/illustration-loop.md; all six
 *  countable Gate 1 checks pass (node scripts/measure-svg.cjs).
 *
 *  Animal-led on purpose. The record says the rejected batch of five was
 *  object-only and read as diagrams, while both scenes that landed had the cat
 *  in them — so the cat stays.
 *
 *  Every animation sits inside prefers-reduced-motion: no-preference, and every
 *  resting value lives on an SVG attribute, so a reduced-motion visitor gets a
 *  complete still scene rather than a mid-animation frame.
 * ========================================================================== */
interface Props {
  /** Caption below the art. Omit for none. */
  caption?: string;
  /** Unique per instance — several on one page must not share a title id. */
  id: string;
  class?: string;
}
const { caption, id, class: className = '' } = Astro.props;
const titleId = `desk-scene-${id}`;

const NAVY = '#1B2A4A';
const ENVLINE = '#A8BACF';
const GREEN = '#16A34A';
const ORANGE = '#F24E1E';

const CHAIR = '#C9D9EC';
const CHAIR_DK = '#8FA8C8';
const DESK = '#E4CBA8';
const SCREEN = '#1B2A4A';
const PALE = '#E8EEF6';
const FLOOR = '#E3EAF3';
const FUR = '#FFFFFF';
const FUR_DK = '#B9C4D2';
const MUG = '#F7B9A3';
const LEAF = '#4EB86B';
const LEAF_LT = '#7DD87D';
const POT = '#FCDCCF';

const W_SUBJ = 2.4;
const W_ENV = 1.6;
const W_FINE = 1.1;

/* Cat body: filled, shaded, then re-contoured, so the shading can sit off the
   line (Gate 1 mis-registration #1 — laid 3 right / 2 down of its contour). */
const CAT_BODY = 'M105 254 C103 222 128 198 172 196 C218 194 246 218 248 254 Z';
const CAT_BACK = 'M105 254 C103 222 128 198 172 196 C206 195 232 210 242 232 C214 220 160 222 128 254 Z';
/* Mis-registration #2: the tallest leaf, filled 3 left / 1.5 down. */
const LEAF_BIG = 'M50 300 C36 274 40 246 50 238 C60 246 62 276 50 300 Z';
---

<figure class:list={['desk', className]}>
  <!--
    viewBox is cropped to the artwork rather than starting at 0.
    The drawing's bounding box runs y=128..380; a full-height 0 0 400 380 box
    left 34% of the image as empty sky, which made it sit visibly low whenever
    it was vertically centred against text. Starting at y=104 keeps ~24 units of
    air above the monitor and nothing else.
  -->
  <svg
    class="scene"
    viewBox="0 104 400 276"
    role="img"
    aria-labelledby={titleId}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={titleId}>
      A cat asleep, curled on an office chair beside a desk. The monitor is still on and a mug of
      coffee sits within reach.
    </title>

    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- ── Floor ── -->
      <path d="M8 340 H400" stroke={ENVLINE} stroke-width={W_ENV} />
      <ellipse cx="152" cy="338" rx="80" ry="6" fill={FLOOR} />
      <ellipse cx="372" cy="335" rx="36" ry="5" fill={FLOOR} />

      <!-- ══ DESK — left end runs behind the cat, right end crops ══ -->
      <rect x="200" y="210" width="200" height="11" rx="2" fill={DESK} stroke={NAVY} stroke-width={W_ENV} />
      <rect x="366" y="221" width="12" height="112" rx="2" fill={DESK} stroke={ENVLINE} stroke-width={W_ENV} />

      <!-- Monitor, still on -->
      <rect x="244" y="128" width="104" height="72" rx="5" fill={SCREEN} stroke={NAVY} stroke-width={W_ENV} />
      <g stroke={PALE} stroke-width={W_FINE} opacity="0.85">
        <path d="M254 144 H318" />
        <path d="M254 154 H336" />
        <path d="M254 164 H302" />
        <path d="M254 174 H326" />
      </g>
      <rect class="caret" x="254" y="181" width="7" height="6" rx="1" fill={PALE} opacity="0.85" />
      <circle class="pip" cx="338" cy="140" r="3" fill={GREEN} />
      <path d="M296 200 L296 209" stroke={NAVY} stroke-width={W_ENV} />
      <path
        d="M278 210 C286 210 292 209 296 208 C300 209 306 210 314 210"
        stroke={NAVY}
        stroke-width={W_ENV}
      />

      <!-- Mug — the one hit of Procedo orange -->
      <g class="steam" stroke="#CBD5E1" stroke-width={W_ENV}>
        <path class="wisp wisp-1" d="M366 180 C363 174 371 170 368 164" />
        <path class="wisp wisp-2" d="M376 180 C373 174 381 170 378 164" />
      </g>
      <path d="M384 192 C392 192 392 204 384 204" stroke={NAVY} stroke-width={W_ENV} />
      <path
        d="M360 186 L360 204 Q360 210 366 210 L378 210 Q384 210 384 204 L384 186 Z"
        fill={MUG}
        stroke={NAVY}
        stroke-width={W_ENV}
      />
      <rect x="361" y="195" width="22" height="4" fill={ORANGE} opacity="0.9" />
      <path d="M360 190 H384" stroke={NAVY} stroke-width={W_ENV} />

      <!-- ══ CHAIR ══ -->
      <path
        d="M68 254 C62 214 64 172 73 155 C80 142 101 140 110 153 C119 168 118 214 114 254 Z"
        fill={CHAIR}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />
      <path
        d="M78 248 C73 214 75 180 82 165 C86 156 96 154 102 161 C95 162 89 168 86 178 C82 196 81 224 84 248 Z"
        fill={CHAIR_DK}
      />
      <path
        d="M64 258 C64 254 68 252 74 252 L242 252 C252 252 258 260 256 268 C254 278 242 284 228 284 L90 284 C76 284 64 272 64 262 Z"
        fill={CHAIR}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />
      <path d="M146 284 L146 314 L159 314 L159 284 Z" fill={CHAIR_DK} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M148 312 L108 332 L113 339 L153 318 Z" fill={CHAIR_DK} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M147 314 L145 336 L158 336 L156 314 Z" fill={CHAIR_DK} stroke={NAVY} stroke-width={W_ENV} />
      <path d="M157 312 L197 332 L192 339 L152 318 Z" fill={CHAIR_DK} stroke={NAVY} stroke-width={W_ENV} />
      <ellipse cx="110" cy="339" rx="6" ry="5" fill={NAVY} />
      <ellipse cx="151" cy="339" rx="6" ry="5" fill={NAVY} />
      <ellipse cx="195" cy="339" rx="6" ry="5" fill={NAVY} />

      <!-- ══ CAT — curled asleep on the seat ══ -->
      <path
        class="tail"
        d="M240 232 C262 230 278 242 276 256 C274 270 256 278 238 273 C232 271 229 265 233 261 C238 257 243 261 249 262 C258 263 266 259 266 252 C266 243 254 239 239 242 Z"
        fill={FUR}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />

      <g class="breathe">
        <path d={CAT_BODY} fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
        <path d={CAT_BACK} fill={FUR_DK} transform="translate(3 2)" />
        <path d={CAT_BODY} fill="none" stroke={NAVY} stroke-width={W_SUBJ} />
      </g>

      <path d="M116 208 L110 188 L129 199 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M143 199 L160 187 L157 207 Z" fill={FUR} stroke={NAVY} stroke-width={W_SUBJ} />
      <path
        d="M109 226 C109 210 120 200 135 200 C150 200 161 210 161 226 C161 242 150 252 135 252 C120 252 109 242 109 226 Z"
        fill={FUR}
        stroke={NAVY}
        stroke-width={W_SUBJ}
      />
      <path d="M112 216 C116 206 124 201 133 202 C122 205 115 211 112 220 Z" fill={FUR_DK} />
      <g stroke={NAVY} stroke-width={W_ENV}>
        <path d="M119 224 Q124 229 129 224" />
        <path d="M141 224 Q146 229 151 224" />
        <path d="M135 232 L135 234" />
        <path d="M131 237 Q135 240 139 237" />
      </g>
      <g stroke={ENVLINE} stroke-width={W_FINE}>
        <path d="M107 230 L97 228" />
        <path d="M107 236 L97 238" />
        <path d="M163 230 L173 228" />
        <path d="M163 236 L173 238" />
      </g>
      <path
        d="M119 248 C125 243 136 243 142 248 C145 252 140 256 131 256 C121 256 115 253 119 248 Z"
        fill={FUR}
        stroke={NAVY}
        stroke-width={W_ENV}
      />

      <!-- ══ FOREGROUND PLANT — crops the bottom edge ══ -->
      <g class="leaves">
        <path d={LEAF_BIG} fill={LEAF} transform="translate(-3 1.5)" />
        <path d={LEAF_BIG} stroke={NAVY} stroke-width={W_ENV} />
        <path
          d="M50 300 C30 288 18 264 22 252 C36 258 48 282 50 300 Z"
          fill={LEAF_LT}
          stroke={NAVY}
          stroke-width={W_ENV}
        />
        <path
          d="M50 300 C70 288 82 268 78 256 C64 262 52 282 50 300 Z"
          fill={LEAF_LT}
          stroke={NAVY}
          stroke-width={W_ENV}
        />
      </g>
      <path d="M18 300 L26 380 L74 380 L82 300 Z" fill={POT} stroke={NAVY} stroke-width={W_SUBJ} />
      <path d="M14 300 H86" stroke={NAVY} stroke-width={W_SUBJ} />
    </g>
  </svg>

  {caption && <figcaption class="line">{caption}</figcaption>}
</figure>

<style>
  .desk {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0;
  }
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }
  .line {
    max-width: 30ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-navy-900);
  }

  @media (prefers-reduced-motion: no-preference) {
    .breathe {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: breathe 4.8s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,
      100% {
        transform: scaleY(1);
      }
      50% {
        transform: scaleY(1.035);
      }
    }

    .tail {
      transform-box: fill-box;
      transform-origin: 8% 55%;
      animation: flick 11s ease-in-out infinite;
    }
    @keyframes flick {
      0%,
      84%,
      100% {
        transform: rotate(0deg);
      }
      89% {
        transform: rotate(-7deg);
      }
      94% {
        transform: rotate(3deg);
      }
    }

    .caret {
      animation: caret 1.4s steps(1, end) infinite;
    }
    @keyframes caret {
      0%,
      50% {
        opacity: 0.85;
      }
      51%,
      100% {
        opacity: 0;
      }
    }

    .pip {
      animation: pip 2.6s ease-in-out infinite;
    }
    @keyframes pip {
      0%,
      100% {
        opacity: 0.4;
      }
      50% {
        opacity: 1;
      }
    }

    .wisp {
      opacity: 0;
      animation: wisp 4.2s ease-in-out infinite;
    }
    .wisp-2 {
      animation-delay: 1.7s;
    }
    @keyframes wisp {
      0% {
        opacity: 0;
        transform: translateY(4px);
      }
      40% {
        opacity: 0.7;
      }
      100% {
        opacity: 0;
        transform: translateY(-10px);
      }
    }

    .leaves {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: sway 6.8s ease-in-out infinite;
    }
    @keyframes sway {
      0%,
      100% {
        transform: rotate(-1.8deg);
      }
      50% {
        transform: rotate(1.8deg);
      }
    }
  }
</style>
