---
// Reusable competency card (light): icon tile, title, tagline, a few feature
// highlights, and a "Learn more" link. Subtle lift + shadow + border shift on
// hover. Used on the Home services section and the Services page.
import { Icon } from 'astro-icon/components';
import type { Competency } from '../data/site';

interface Props {
  competency: Competency;
  delay?: number;
  class?: string;
}
const { competency: c, delay = 0, class: className = '' } = Astro.props;
const features = c.groups.flatMap((g) => g.items).slice(0, 4);
---

<a
  href={`/services#${c.slug}`}
  data-reveal
  style={`--reveal-delay:${delay}ms`}
  class:list={[
    'group flex flex-col rounded-xl border border-line bg-white p-7 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg hover:shadow-navy-950/[0.06]',
    className,
  ]}
>
  <span
    class="grid size-12 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition-colors duration-200 group-hover:bg-brand-500 group-hover:text-white"
  >
    <Icon name={c.icon} class="size-6" aria-hidden="true" />
  </span>

  <h3 class="mt-5 text-lg font-semibold text-navy-950">{c.title}</h3>
  <p class="mt-1.5 text-sm font-medium text-slate-500">{c.tagline}</p>

  <ul class="mt-4 space-y-2 text-sm text-slate-600">
    {
      features.map((f) => (
        <li class="flex items-start gap-2">
          <Icon name="lucide:check" class="mt-0.5 size-4 shrink-0 text-brand-500" aria-hidden="true" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>

  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
    Learn more
    <Icon
      name="lucide:arrow-right"
      class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  </span>
</a>
