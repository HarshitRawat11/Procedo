---
// Section heading (light theme): a monospaced eyebrow with an orange tick, a
// calm navy title (medium weight, restrained size), and a muted slate subtitle.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  class?: string;
}
const { eyebrow, title, subtitle, center = false, class: className = '' } = Astro.props;
---

<div class:list={[center && 'text-center', className]}>
  {
    eyebrow && (
      <p
        class:list={[
          'flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.18em] text-navy-600',
          center && 'justify-center',
        ]}
      >
        <span class="inline-block h-px w-7 bg-brand-500" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-4 text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-tight text-navy-950">
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg',
          center && 'mx-auto',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
