---
// Closing call-to-action — a contained navy panel on the light page for a
// premium, high-contrast finish (no logo here, so dark reads fine).
import Container from './Container.astro';
import Button from './Button.astro';
import { closingCta } from '../data/site';
---

<section class="bg-cream py-20 lg:py-28">
  <Container>
    <div
      data-reveal
      class="relative overflow-hidden rounded-2xl bg-navy-950 px-8 py-14 sm:px-14 lg:py-20"
    >
      <div
        class="absolute -right-20 -top-20 size-80 rounded-full bg-brand-500/15 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-2xl text-center">
        <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold leading-tight text-white">
          {closingCta.heading}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-slate-300">{closingCta.sub}</p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={closingCta.primary.href} size="lg" chevron>{closingCta.primary.label}</Button>
          <Button href={closingCta.secondary.href} size="lg" variant="secondary">
            {closingCta.secondary.label}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
