---
/* ============================================================================
 *  /contact-preview — PREVIEW ONLY (option A). Sealed off per CLAUDE.md §5:
 *  noindex, in no nav, linked from nowhere, excluded from the sitemap filter.
 *
 *  The reception illustration in the /our-mission layout, straight under the
 *  header: the page's subtitle promoted to a statement in large type on the
 *  left, the panel on the right, then the direct channels and the form exactly
 *  as they are on the live page. The header drops its subtitle, as the mission
 *  page's does, so the sentence is not read twice.
 *
 *  Harshit liked the illustration but not its first position (top of the
 *  left-hand column, beside the form). Option B — the illustration closing the
 *  page beside the office address, with the form kept high — is at
 *  /contact-preview-b. One of the two gets ported into contact.astro; both
 *  preview pages are then deleted.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ReceptionScene from '../components/preview/ReceptionScene.astro';
import { Icon } from 'astro-icon/components';
import { contact, competencies, receptionBand, contactStatement } from '../data/site';

const telHref = 'tel:' + contact.phone.replace(/[^+\d]/g, '');

const channels = [
  {
    icon: 'lucide:mail',
    label: 'General enquiries',
    value: contact.email,
    href: `mailto:${contact.email}`,
  },
  {
    icon: 'lucide:briefcase',
    label: 'Sales',
    value: contact.salesEmail,
    href: `mailto:${contact.salesEmail}`,
  },
  { icon: 'lucide:phone', label: 'Phone', value: contact.phone, href: telHref },
];
---

<BaseLayout title="Contact — illustration preview A" noindex>
  <div class="pv-banner">
    <Container>
      <p class="pv-banner-txt">
        <strong>Internal preview — option A.</strong> The reception illustration straight under the
        header in the Our Mission layout: statement left, panel right, channels and form below.
        Option B, with the illustration closing the page beside the office address, is at
        <a href="/contact-preview-b">/contact-preview-b</a>; option C, a small crop of the cat picking
        up the phone beside the form's Send button, at
        <a href="/contact-preview-c">/contact-preview-c</a>. Not linked from the site, not indexed.
      </p>
    </Container>
  </div>

  <PageHeader eyebrow="Contact" title="Let’s talk about your systems" />

  <!-- Statement, with the illustration alongside — the /our-mission layout -->
  <section class="bg-cream py-16 lg:py-24">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7" data-reveal>
          <blockquote
            class="border-l-2 border-brand-500 pl-6 text-[clamp(1.35rem,2.6vw,1.85rem)] font-semibold leading-snug text-navy-950"
          >
            {contactStatement}
          </blockquote>
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <div class="rounded-2xl border border-line bg-band px-5 pt-7 pb-8">
            <ReceptionScene id="contact" chip={receptionBand.chip} caption={receptionBand.caption} />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Direct channels and the form, as on the live page -->
  <section class="border-t border-line bg-cream py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div data-reveal>
          <h2 class="text-xl font-semibold text-navy-950">Reach us directly</h2>
          <div class="mt-6 space-y-4">
            {
              channels.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm transition-colors hover:border-brand-300"
                >
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name={c.icon} class="size-5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      {c.label}
                    </span>
                    <span class="block break-all font-medium text-navy-900">{c.value}</span>
                  </span>
                </a>
              ))
            }

            {
              contact.address && (
                <div class="flex items-start gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm">
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name="lucide:map-pin" class="size-5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      Office
                    </span>
                    <span class="block font-medium leading-relaxed text-navy-900">
                      {contact.address}
                    </span>
                  </span>
                </div>
              )
            }
          </div>

          <!-- What we can help with -->
          <div class="mt-10 rounded-xl border border-line bg-band p-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">
              What we can help with
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {
                competencies.map((c) => (
                  <li>
                    <a
                      href={`/services#${c.slug}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1.5 text-sm text-navy-800 transition-colors hover:border-brand-300 hover:text-brand-700"
                    >
                      <Icon name={c.icon} class="size-3.5 text-brand-500" aria-hidden="true" />
                      {c.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Form -->
        <div
          data-reveal
          style="--reveal-delay:100ms"
          class="rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8"
        >
          <h2 class="text-xl font-semibold text-navy-950">Send us a message</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Share a few details and the right engineer will get back to you.
          </p>
          <div class="mt-7">
            <ContactForm />
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .pv-banner {
    background: var(--color-navy-950);
    color: #fff;
    padding: 0.75rem 0;
  }
  .pv-banner-txt {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.78);
  }
  .pv-banner-txt strong {
    color: #fff;
    font-weight: 600;
  }
  .pv-banner-txt a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
