---
/* ============================================================================
 *  STANDALONE CONCEPT PAGE — /quiet
 *
 *  An empty-state / "all clear" screen in the spirit of Google Chat's
 *  "Nothing unread" illustration, themed for Procedo.
 *
 *  ⚠️ NOT part of the website: it is deliberately not in `nav`, not linked from
 *  any page, marked noindex, and excluded from the sitemap (see
 *  astro.config.mjs). It does not use BaseLayout, so it carries no site header
 *  or footer — it stands completely on its own.
 *
 *  The premise: for an infrastructure company, quiet IS the deliverable. Zero
 *  alerts is the best dashboard there is. Hence a cat asleep on a warm rack.
 *
 *  Everything is hand-authored inline SVG (no image files) using the site's own
 *  design tokens, and every animation is disabled under
 *  `prefers-reduced-motion: reduce`.
 * ========================================================================== */
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

/** Rotating empty-state lines, in Procedo's register. */
const lines = [
  'All systems nominal. Go enjoy the quiet.',
  'Zero alerts. The best dashboard is a boring one.',
  'Everything’s humming. Nothing needs you.',
  'No incidents today. Precisely as designed.',
  'Quiet racks. Happy engineers.',
  'Uptime’s holding. Take the long lunch.',
  'Nothing to escalate, nothing to firefight.',
  'The servers are fine. The cat made sure.',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>All systems nominal | Procedo Infosystems</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FBFAF8" />
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>

  <body>
    <main class="stage">
      <!-- Status chip -->
      <p class="chip">
        <span class="chip-dot" aria-hidden="true"></span>
        All systems nominal
      </p>

      <!-- Scene -->
      <div class="art">
        <svg
          class="scene"
          viewBox="0 0 420 330"
          role="img"
          aria-labelledby="scene-title"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="scene-title">
            A cat asleep on a cushion atop a quietly humming server rack, beside a mug of
            coffee and a potted plant. Every status light is green.
          </title>

          <g class="float" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <!-- ── Cloud ── -->
            <path
              class="cloud"
              d="M60 80 C55 80 54 71 61 69 C62 60 74 57 80 63 C86 56 99 59 100 68 C108 68 110 79 104 80 Z"
              fill="#FFFFFF"
              stroke="#1B2A4A"
              stroke-width="2"
            />

            <!-- ── Ground ── -->
            <ellipse cx="209" cy="292" rx="74" ry="6" fill="#F3F4F6" />
            <path d="M48 292 H384" stroke="#CBD5E1" stroke-width="2" />

            <!-- ── Rack cabinet ── -->
            <rect
              x="150"
              y="132"
              width="118"
              height="158"
              rx="8"
              fill="#FFFFFF"
              stroke="#1B2A4A"
              stroke-width="2"
            />

            <!-- Monitoring panel: a reassuringly flat line -->
            <rect x="160" y="142" width="98" height="30" rx="4" fill="#F3F4F6" />
            <path d="M167 158 H251" stroke="#16A34A" stroke-width="2" opacity="0.5" />
            <circle class="blip" cx="167" cy="158" r="2.5" fill="#16A34A" />

            <!-- Status + vent module -->
            <rect x="160" y="178" width="98" height="26" rx="4" stroke="#1B2A4A" stroke-width="2" />
            <circle class="led led-1" cx="171" cy="191" r="3" fill="#16A34A" />
            <circle class="led led-2" cx="183" cy="191" r="3" fill="#16A34A" />
            <circle class="led led-3" cx="195" cy="191" r="3" fill="#16A34A" />
            <g stroke="#CBD5E1" stroke-width="2">
              <path d="M214 185 H250" />
              <path d="M214 191 H250" />
              <path d="M214 197 H250" />
            </g>

            <!-- Fan module -->
            <rect x="160" y="210" width="98" height="34" rx="4" stroke="#1B2A4A" stroke-width="2" />
            <g transform="translate(185 227)">
              <circle r="13" stroke="#1B2A4A" stroke-width="2" />
              <g class="blades" fill="#CBD5E1">
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(90)" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(180)" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(270)" />
              </g>
              <circle r="2.5" fill="#1B2A4A" />
            </g>
            <g transform="translate(233 227)">
              <circle r="13" stroke="#1B2A4A" stroke-width="2" />
              <g class="blades blades-slow" fill="#CBD5E1">
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(90)" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(180)" />
                <path d="M0 0 C-5.5 -7 -4 -12 0 -12 C4 -12 5.5 -7 0 0 Z" transform="rotate(270)" />
              </g>
              <circle r="2.5" fill="#1B2A4A" />
            </g>

            <!-- Drive bays -->
            <rect x="160" y="250" width="98" height="32" rx="4" stroke="#1B2A4A" stroke-width="2" />
            <g>
              <rect x="167" y="254" width="84" height="6" rx="2" fill="#F3F4F6" />
              <circle class="led led-1" cx="246" cy="257" r="1.8" fill="#16A34A" />
              <rect x="167" y="264" width="84" height="6" rx="2" fill="#F3F4F6" />
              <circle class="led led-2" cx="246" cy="267" r="1.8" fill="#16A34A" />
              <rect x="167" y="274" width="84" height="6" rx="2" fill="#F3F4F6" />
              <circle class="led led-3" cx="246" cy="277" r="1.8" fill="#16A34A" />
            </g>

            <!-- ── Cushion ── -->
            <ellipse cx="212" cy="130" rx="40" ry="8" fill="#FCDCCF" />

            <!-- ── Sleeping cat ── -->
            <g class="cat">
              <!-- tail, curled round the front -->
              <path
                class="tail"
                d="M182 126 C170 128 164 120 170 113 C174 108 181 110 181 116"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <!-- body, with the faintest tabby markings -->
              <g class="breathe">
                <path
                  d="M180 128 C178 110 190 98 208 98 C226 98 242 106 244 128 Z"
                  fill="#FFFFFF"
                  stroke="#1B2A4A"
                  stroke-width="2"
                />
                <g stroke="#CBD5E1" stroke-width="2">
                  <path d="M193 102 Q197 107 195 112" />
                  <path d="M203 99.5 Q207 104 205 109" />
                </g>
              </g>
              <!-- tucked front paw -->
              <ellipse
                cx="213"
                cy="124.5"
                rx="8.5"
                ry="3.5"
                fill="#FFFFFF"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <!-- ears (drawn behind the head, so only the tips show) -->
              <path
                d="M227.5 108 L228 96 L237 103.5 Z"
                fill="#FFFFFF"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <path
                d="M241 103.5 L248 97 L247.5 110 Z"
                fill="#FFFFFF"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <!-- head -->
              <circle cx="236" cy="116" r="12" fill="#FFFFFF" stroke="#1B2A4A" stroke-width="2" />
              <!-- closed, contented eyes -->
              <path d="M228 114 Q231 117 234 114" stroke="#1B2A4A" stroke-width="1.8" />
              <path d="M239 114 Q242 117 245 114" stroke="#1B2A4A" stroke-width="1.8" />
              <!-- nose + whiskers -->
              <path d="M236 119.5 L236 121" stroke="#1B2A4A" stroke-width="1.8" />
              <g stroke="#CBD5E1" stroke-width="1.4">
                <path d="M227 119 L222.5 118" />
                <path d="M245 119 L249.5 118" />
              </g>
            </g>

            <!-- ── Mug ── -->
            <g class="steam" stroke="#CBD5E1" stroke-width="2">
              <path class="wisp wisp-1" d="M103 262 C100 256 108 252 105 246" />
              <path class="wisp wisp-2" d="M112 262 C109 256 117 252 114 246" />
            </g>
            <path
              d="M96 268 L96 286 Q96 292 102 292 L114 292 Q120 292 120 286 L120 268 Z"
              fill="#FFFFFF"
              stroke="#1B2A4A"
              stroke-width="2"
            />
            <!-- the one hit of Procedo orange down here, to balance the cushion above -->
            <rect x="97" y="278" width="22" height="5" fill="#F24E1E" opacity="0.9" />
            <path d="M96 273 H120" stroke="#1B2A4A" stroke-width="2" />
            <path d="M120 275 C130 275 130 287 120 287" stroke="#1B2A4A" stroke-width="2" />

            <!-- ── Plant ── -->
            <g class="leaves">
              <path
                d="M330 274 C322 258 326 244 332 240 C338 246 338 262 330 274 Z"
                fill="#DCFCE7"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <path
                d="M330 274 C318 266 312 254 314 248 C322 250 330 262 330 274 Z"
                fill="#DCFCE7"
                stroke="#1B2A4A"
                stroke-width="2"
              />
              <path
                d="M330 274 C342 266 348 256 346 250 C338 252 331 263 330 274 Z"
                fill="#DCFCE7"
                stroke="#1B2A4A"
                stroke-width="2"
              />
            </g>
            <path
              d="M314 274 L318 292 H342 L346 274 Z"
              fill="#FCDCCF"
              stroke="#1B2A4A"
              stroke-width="2"
            />
            <path d="M312 274 H348" stroke="#1B2A4A" stroke-width="2" />

            <!-- ── Grass ── -->
            <g stroke="#22C55E" stroke-width="3">
              <g class="grass">
                <path d="M62 292 C61 284 64 277 69 272" />
                <path d="M68 292 C68 284 70 278 74 274" />
                <path d="M74 292 C74 285 73 280 71 276" />
              </g>
              <g class="grass grass-b">
                <path d="M356 292 C355 284 358 277 363 272" />
                <path d="M363 292 C363 284 365 278 369 273" />
                <path d="M370 292 C370 285 369 280 367 277" />
              </g>
            </g>
          </g>
        </svg>
      </div>

      <!-- Rotating line -->
      <p class="line" id="line" data-lines={JSON.stringify(lines)}>{lines[0]}</p>

      <p class="caption">Procedo Infosystems · empty-state concept</p>
    </main>

    <style>
      .stage {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 3rem 1.5rem;
        text-align: center;
      }

      /* ---- Status chip ---- */
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.4rem 0.9rem 0.4rem 0.75rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-navy-700);
      }
      .chip-dot {
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 999px;
        background: #16a34a;
        box-shadow: 0 0 0 3px rgb(22 163 74 / 0.14);
      }

      /* ---- Scene ---- */
      .art {
        width: 100%;
        max-width: 27rem;
        margin: 2.25rem 0 0.5rem;
      }
      .scene {
        display: block;
        width: 100%;
        height: auto;
      }

      /* ---- Type ---- */
      .line {
        max-width: 30ch;
        font-size: clamp(1.0625rem, 2.4vw, 1.3125rem);
        font-weight: 500;
        line-height: 1.45;
        color: var(--color-navy-950);
        transition: opacity 500ms ease;
      }
      .line[data-fading='true'] {
        opacity: 0;
      }
      .caption {
        margin-top: 2.5rem;
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #94a3b8;
      }

      /* ======================================================================
         Motion — every animation lives inside this guard, so a visitor with
         "reduce motion" set gets a completely still (and still complete) scene.
         ==================================================================== */
      @media (prefers-reduced-motion: no-preference) {
        /* whole scene breathes upward, barely */
        .float {
          animation: float 7s ease-in-out infinite;
        }
        @keyframes float {
          0%,
          100% {
            transform: translateY(0);
          }
          50% {
            transform: translateY(-5px);
          }
        }

        /* fans turn slowly — the sound of nothing going wrong */
        .blades {
          transform-box: fill-box;
          transform-origin: 50% 50%;
          animation: spin 14s linear infinite;
        }
        .blades-slow {
          animation-duration: 19s;
          animation-direction: reverse;
        }
        @keyframes spin {
          to {
            transform: rotate(360deg);
          }
        }

        /* status lights, gently out of step with each other */
        .led {
          animation: led 2.4s ease-in-out infinite;
        }
        .led-2 {
          animation-delay: 0.5s;
        }
        .led-3 {
          animation-delay: 1s;
        }
        @keyframes led {
          0%,
          100% {
            opacity: 0.35;
          }
          50% {
            opacity: 1;
          }
        }
        .chip-dot {
          animation: led 2.4s ease-in-out infinite;
        }

        /* the monitoring dot crosses a flat line, forever */
        .blip {
          animation: blip 6s linear infinite;
        }
        @keyframes blip {
          0% {
            transform: translateX(0);
            opacity: 0;
          }
          8%,
          92% {
            opacity: 1;
          }
          100% {
            transform: translateX(84px);
            opacity: 0;
          }
        }

        /* cat: slow breathing, and an occasional tail flick */
        .breathe {
          transform-box: fill-box;
          transform-origin: 50% 100%;
          animation: breathe 4.5s ease-in-out infinite;
        }
        @keyframes breathe {
          0%,
          100% {
            transform: scaleY(1);
          }
          50% {
            transform: scaleY(1.04);
          }
        }
        .tail {
          transform-box: fill-box;
          transform-origin: 100% 60%;
          animation: tail 9s ease-in-out infinite;
        }
        @keyframes tail {
          0%,
          80%,
          100% {
            transform: rotate(0deg);
          }
          87% {
            transform: rotate(-8deg);
          }
          93% {
            transform: rotate(4deg);
          }
        }

        /* coffee steam */
        .wisp {
          opacity: 0;
          animation: wisp 4s ease-in-out infinite;
        }
        .wisp-2 {
          animation-delay: 1.6s;
        }
        @keyframes wisp {
          0% {
            opacity: 0;
            transform: translateY(4px);
          }
          40% {
            opacity: 0.75;
          }
          100% {
            opacity: 0;
            transform: translateY(-10px);
          }
        }

        /* cloud drifts; plant and grass sway */
        .cloud {
          animation: drift 18s ease-in-out infinite alternate;
        }
        @keyframes drift {
          from {
            transform: translateX(-6px);
          }
          to {
            transform: translateX(12px);
          }
        }
        .leaves {
          transform-box: fill-box;
          transform-origin: 50% 100%;
          animation: sway 6s ease-in-out infinite;
        }
        .grass {
          transform-box: fill-box;
          transform-origin: 50% 100%;
          animation: sway 5s ease-in-out infinite;
        }
        .grass-b {
          animation-duration: 6.5s;
          animation-delay: -2s;
        }
        @keyframes sway {
          0%,
          100% {
            transform: rotate(-2.5deg);
          }
          50% {
            transform: rotate(2.5deg);
          }
        }
      }
    </style>

    <script>
      // Rotate the line: random start so each visit feels a little different,
      // then a slow crossfade. Skips the fade (but keeps rotating) for anyone
      // who has asked for reduced motion, and pauses while the tab is hidden.
      const el = document.getElementById('line');
      const lines: string[] = JSON.parse(el?.dataset.lines ?? '[]');

      if (el && lines.length > 1) {
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let i = Math.floor(Math.random() * lines.length);
        el.textContent = lines[i];

        setInterval(() => {
          if (document.hidden) return;
          i = (i + 1) % lines.length;

          if (calm) {
            el.textContent = lines[i];
            return;
          }
          el.dataset.fading = 'true';
          setTimeout(() => {
            el.textContent = lines[i];
            el.dataset.fading = 'false';
          }, 500);
        }, 7000);
      }
    </script>
  </body>
</html>
