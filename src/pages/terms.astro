---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { termsOfService } from '../data/site';
import { graph, breadcrumbs } from '../lib/schema';

/* The legal pages carried no structured data at all until 2026-09-18.
   BaseLayout now gives every page the Organization and WebSite nodes;
   this adds the trail, so the three of them stop being orphans in the
   graph the way every other page already was not. */
const schema = graph(breadcrumbs([{ name: 'Terms of Service', path: '/terms' }]));
---

<BaseLayout
  title="Terms of Service"
  description="The terms governing your use of the Procedo Infosystems website and services — acceptable use, intellectual property, liability and termination."
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <LegalDoc doc={termsOfService} />
</BaseLayout>
