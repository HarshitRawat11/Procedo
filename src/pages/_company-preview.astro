---
/* ============================================================================
 *  /company-preview — PREVIEW ONLY. Sealed off per CLAUDE.md §5: noindex, in no
 *  nav, linked from nowhere, excluded from the sitemap filter.
 *
 *  The Company page laid out the way /our-mission is: a statement in large type
 *  on the left, the illustration in a bordered panel on the right, with a chip
 *  above and a caption below. Harshit asked for "the location of the image
 *  something like the mission page" after seeing it in the page header.
 *
 *  The statement is the third overview paragraph — the one about "technical
 *  precision and implementation clarity", which is what the picture is about.
 *  It is promoted here and removed from the Overview section below so it does
 *  not appear twice. Everything is Procedo's own copy from site.ts; nothing is
 *  new.
 *
 *  Revision history for this placement: band between values and why-us
 *  (disliked) → page-header aside (disliked) → this. PageHeader keeps its
 *  optional `aside` slot; unused here, inert everywhere.
 *
 *  PARKED AGAIN 2026-09-14, on adoption. It was un-parked earlier the same day
 *  so the rebuilt CompanyScene could be reviewed in context; Harshit signed the
 *  scene off, this section now ships on the real /company page, and the scene
 *  itself has moved to components/. So the page duplicates the live one and the
 *  underscore is back.
 *
 *  Kept rather than deleted, deliberately and for the same reason as
 *  _careers-preview: it is the rehearsal space for the next change to that
 *  band. Drop the underscore to bring it back, and remember it then needs the
 *  live section copied into it — this file has drifted from company.astro the
 *  moment either one is edited.
 *
 *  The sitemap filter in astro.config.mjs still names '/company-preview', also
 *  deliberately, so an un-parked page cannot walk into the sitemap by accident.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ClosingCta from '../components/ClosingCta.astro';
import CompanyScene from '../components/CompanyScene.astro';
import { Icon } from 'astro-icon/components';
import { company, whyUs, competencies, workshopBand } from '../data/site';

const [overviewA, overviewB, statement] = company.overview;
---

<BaseLayout title="Company — illustration preview" noindex>
  <div class="pv-banner">
    <Container>
      <p class="pv-banner-txt">
        <strong>Internal preview.</strong> The Company page with the workshop illustration in the Our
        Mission layout — statement left, panel right. Not linked from the site, not indexed.
      </p>
    </Container>
  </div>

  <PageHeader
    eyebrow="Company"
    title="Company Overview"
    subtitle="An infrastructure-first technology firm — bringing IT, security, AV, digital workplace and datacenter infrastructure together into systems that quietly work."
  />

  <!-- Statement, with the illustration alongside — the /our-mission layout -->
  <section class="bg-cream py-12 lg:py-16">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7" data-reveal>
          <blockquote
            class="border-l-2 border-brand-500 pl-6 text-[clamp(1.35rem,2.6vw,1.85rem)] font-semibold leading-snug text-navy-950"
          >
            {statement}
          </blockquote>
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <div class="rounded-2xl border border-line bg-band px-5 pt-7 pb-8">
            <CompanyScene id="company" chip={workshopBand.chip} caption={workshopBand.caption} />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Overview: the first two paragraphs, and what we deliver -->
  <section class="border-t border-line bg-cream py-12 lg:py-16">
    <Container>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-3xl space-y-6 lg:col-span-7" data-reveal>
          <p class="text-lg leading-relaxed text-slate-600">{overviewA}</p>
          <p class="text-lg leading-relaxed text-slate-600">{overviewB}</p>
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <div
            class="overflow-hidden rounded-xl border border-line bg-white shadow-sm shadow-navy-950/[0.04]"
          >
            <p
              class="border-b border-line px-6 py-4 font-mono text-xs uppercase tracking-[0.18em] text-navy-600"
            >
              What we deliver
            </p>
            <ul>
              {
                competencies.map((c, i) => (
                  <li class={i > 0 ? 'border-t border-line' : ''}>
                    <a
                      href={`/services#${c.slug}`}
                      class="group flex items-center gap-4 px-6 py-4 transition-colors hover:bg-band"
                    >
                      <span class="grid size-9 shrink-0 place-items-center rounded-md bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                        <Icon name={c.icon} class="size-[18px]" aria-hidden="true" />
                      </span>
                      <span class="min-w-0 flex-1 text-sm font-medium text-navy-900">{c.title}</span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="size-4 text-slate-400 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Core values -->
  <section id="values" class="scroll-mt-24 border-t border-line bg-band py-12 lg:py-16">
    <Container>
      <SectionHeading
        eyebrow="Our core values"
        title="What we stand for"
        subtitle={company.valuesIntro}
      />
      <FeatureGrid items={company.values} columns={3} class="mt-12" />
    </Container>
  </section>

  <!-- Why us -->
  <section id="why-us" class="scroll-mt-24 bg-cream py-12 lg:py-16">
    <Container>
      <SectionHeading
        eyebrow="Why us?"
        title="Why partner with Procedo?"
        subtitle="Experience the future of infrastructure-driven success with industry-leading expertise."
      />
      <FeatureGrid items={whyUs} columns={4} class="mt-12" />
    </Container>
  </section>

  <ClosingCta />
</BaseLayout>

<style>
  .pv-banner {
    background: var(--color-navy-950);
    color: #fff;
    padding: 0.75rem 0;
  }
  .pv-banner-txt {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.78);
  }
  .pv-banner-txt strong {
    color: #fff;
    font-weight: 600;
  }
</style>
