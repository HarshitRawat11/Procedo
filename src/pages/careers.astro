---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ClosingCta from '../components/ClosingCta.astro';
import CareersScene from '../components/CareersScene.astro';
import { Icon } from 'astro-icon/components';
import { careers } from '../data/site';
import { graph, breadcrumbs } from '../lib/schema';

const schema = graph(breadcrumbs([{ name: 'Careers', path: '/careers' }]));
---

<BaseLayout
  title="Careers"
  description="Join Procedo Infosystems — engineers and specialists building scalable digital infrastructure, secure smart environments and immersive communication spaces."
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  {/*
    The header's aside slot carries a SECOND, smaller copy of CareersScene.
    Harshit, 2026-09-16: the header is left-aligned with the subtitle capped for
    a readable measure, so the top-right corner of the page was empty white.

    It is deliberately the same drawing as the one in the open-application card
    below — his ask, "a duplicate careers image". Capped at 15rem rather than the
    component's own 22rem so it reads as a header ornament and does not compete
    with the one further down, which is the one doing the work.

    Its `id` must differ from that one: the component builds its <title> id from
    the prop, and two elements sharing an id is invalid and breaks the
    aria-labelledby on both.
  */}
  <PageHeader eyebrow="Careers" title="Build systems that matter" subtitle={careers.intro}>
    <div slot="aside" class="mx-auto w-full max-w-[20rem] lg:ml-auto lg:mr-0">
      <CareersScene id="careers-header" />
    </div>
  </PageHeader>

  <!-- Why work with us -->
  <section class="bg-cream py-12 lg:py-16">
    <Container>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5" data-reveal>
          <p
            class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.18em] text-navy-600"
          >
            <span class="inline-block h-px w-7 bg-brand-500" aria-hidden="true"></span>
            Life at Procedo
          </p>
          <h2 class="mt-4 text-2xl font-semibold text-navy-950 sm:text-3xl">
            {careers.cultureTitle}
          </h2>
          {/*
            A paragraph stood here until 2026-09-18 and was deleted under rule
            #1: "We are a small, senior team — which means your work is visible,
            your decisions carry weight, and you learn across every layer of the
            stack." Nobody at Procedo said that. It states the size and the
            seniority of the team, and neither the old site's bundle nor any
            client revision contains it or anything like it.

            It is not replaced, per rule #3 — a missing value hides its feature
            rather than showing something invented in its place. The four
            culture bullets to the right carry the section. See the note in
            site.ts if a real line ever arrives.
          */}
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {
            careers.culture.map((c, i) => (
              <li
                data-reveal
                style={`--reveal-delay:${(i % 2) * 80}ms`}
                class="flex items-start gap-3 rounded-xl border border-line bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-ink-300 hover:shadow-lg hover:shadow-navy-950/[0.06]"
              >
                <Icon
                  name="lucide:circle-check"
                  class="mt-0.5 size-5 shrink-0 text-brand-500"
                  aria-hidden="true"
                />
                <span class="text-sm leading-relaxed text-ink-700">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <!-- Roles -->
  <section class="border-t border-line bg-band py-12 lg:py-16">
    <Container>
      <SectionHeading
        eyebrow="Open disciplines"
        title={careers.rolesTitle}
        subtitle={careers.rolesIntro}
      />

      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          careers.roles.map((r, i) => (
            <article
              data-reveal
              style={`--reveal-delay:${(i % 3) * 80}ms`}
              class="flex flex-col rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-ink-300 hover:shadow-lg hover:shadow-navy-950/[0.06]"
            >
              <span class="grid size-11 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                <Icon name={r.icon} class="size-5" aria-hidden="true" />
              </span>
              <h3 class="mt-5 text-base font-semibold text-navy-950">{r.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{r.body}</p>
              <a
                href={`mailto:${careers.applyEmail}?subject=${encodeURIComponent('Application: ' + r.title)}`}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-700"
              >
                Apply for this role
                <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
              </a>
            </article>
          ))
        }
      </div>

      <!-- Open application -->
      <div
        class="mt-10 flex flex-col items-start justify-between gap-5 rounded-2xl border border-line bg-white p-7 shadow-sm lg:flex-row lg:items-center lg:gap-8"
        data-reveal
      >
        <!-- The cat at work. Decorative support for the copy beside it, so it
             takes no caption of its own. 288px rather than the 208px it had: at
             208 the cat renders 42px wide against the 404 cat's 78px, and the
             monitor and mouse stop reading. -->
        <div class="w-56 shrink-0 self-center lg:w-72">
          <CareersScene id="careers" />
        </div>
        <div class="min-w-0 lg:flex-1">
          <h2 class="text-base font-semibold text-navy-950">{careers.openTitle}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-600">{careers.openBody}</p>
        </div>
        <a
          href={`mailto:${careers.applyEmail}?subject=${encodeURIComponent('Open application')}`}
          class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-[15px] font-medium text-white shadow-sm shadow-brand-700/20 transition-all duration-200 hover:bg-brand-700 active:scale-[0.98]"
        >
          <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
          {careers.applyEmail}
        </a>
      </div>
    </Container>
  </section>

  <ClosingCta />
</BaseLayout>
