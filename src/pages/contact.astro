---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ReceptionScene from '../components/ReceptionScene.astro';
import { Icon } from 'astro-icon/components';
import {
  contact,
  competencies,
  contactCopy,
  contactStatement,
  directionsHref,
  whatsappHref,
} from '../data/site';
import { graph, breadcrumbs } from '../lib/schema';

const telHref = 'tel:' + contact.phone.replace(/[^+\d]/g, '');

const channels = [
  {
    icon: 'lucide:mail',
    label: 'General enquiries',
    value: contact.email,
    href: `mailto:${contact.email}`,
  },
  {
    icon: 'lucide:briefcase',
    label: 'Sales',
    value: contact.salesEmail,
    href: `mailto:${contact.salesEmail}`,
  },
  { icon: 'lucide:phone', label: 'Phone', value: contact.phone, href: telHref },
  /* Same line as the phone, so it is listed as a channel rather than repeated
     as a number. Drops out entirely if the number is ever removed (§3). */
  ...(whatsappHref
    ? [
        {
          icon: 'lucide:message-circle',
          label: 'WhatsApp',
          value: 'Start a chat',
          href: whatsappHref,
        },
      ]
    : []),
];

const schema = graph(breadcrumbs([{ name: 'Contact', path: '/contact' }]));
---

<BaseLayout
  title="Contact"
  description={`Talk to Procedo Infosystems about your IT, security, AV, digital workplace or datacenter infrastructure. Email ${contact.email} or call ${contact.phone}.`}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  {/*
    Same treatment as /careers: the header is left-aligned with its subtitle
    capped for a readable measure, so the top-right corner was empty white.

    This is ReceptionScene, the contact page's own scene, at 20rem. Its id must
    differ from the success card's "cf-done" — the component builds its <title>
    id from the prop, and two elements sharing an id breaks aria-labelledby on
    both. No chip or caption here: at this size they would crowd it, and the
    copy belongs to the success card, which is the one that has earned it.

    The sequence plays once on load, so the header shows the ring and the
    pickup; the success card's copy restarts when it is un-hidden, because
    display:none cancels a CSS animation and showing the element runs it again
    from zero.
  */}
  <PageHeader
    eyebrow="Contact"
    title="Let’s talk about your systems"
    subtitle={contactStatement}
  >
    <div slot="aside" class="mx-auto w-full max-w-[20rem] lg:ml-auto lg:mr-0">
      <ReceptionScene id="contact-header" />
    </div>
  </PageHeader>

  <section class="bg-cream py-12 lg:py-16">
    <Container>
      <!-- lg:items-start matters: without it the grid stretches the white
           panel to match the taller details column, which left 176px of
           dead white under the Send button and 185px under the success
           card. Measured at 1440px on 2026-09-13. -->
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <!-- Direct channels -->
        <div data-reveal>
          <h2 class="text-xl font-semibold text-navy-950">{contactCopy.directTitle}</h2>
          <div class="mt-6 space-y-4">
            {
              channels.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm transition-colors hover:border-brand-300"
                >
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name={c.icon} class="size-5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-medium uppercase tracking-wider text-ink-500">
                      {c.label}
                    </span>
                    <span class="block break-all font-medium text-navy-900">{c.value}</span>
                  </span>
                </a>
              ))
            }

            {
              contact.address && (
                <div class="flex items-start gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm">
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name="lucide:map-pin" class="size-5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-medium uppercase tracking-wider text-ink-500">
                      {contactCopy.officeTitle}
                    </span>
                    <span class="block font-medium leading-relaxed text-navy-900">
                      {contact.address}
                    </span>
                    {contact.reach && (
                      <span class="mt-1 block text-sm text-ink-500">{contact.reach}</span>
                    )}
                    {directionsHref && (
                      <a
                        href={directionsHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 underline-offset-2 hover:underline"
                      >
                        Get directions
                        <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
                      </a>
                    )}
                  </span>
                </div>
              )
            }
          </div>

          <!-- What we can help with -->
          <div class="mt-10 rounded-xl border border-line bg-band p-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">
              {contactCopy.helpTitle}
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {
                competencies.map((c) => (
                  <li>
                    <a
                      href={`/services#${c.slug}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1.5 text-sm text-navy-800 transition-colors hover:border-brand-300 hover:text-brand-700"
                    >
                      <Icon name={c.icon} class="size-3.5 text-brand-500" aria-hidden="true" />
                      {c.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Form -->
        <div
          data-reveal
          style="--reveal-delay:100ms"
          class="rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8"
        >
          <h2 class="text-xl font-semibold text-navy-950">{contactCopy.formTitle}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{contactCopy.formIntro}</p>
          <div class="mt-7">
            <ContactForm />
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
