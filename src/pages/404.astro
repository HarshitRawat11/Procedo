---
/* ============================================================================
 *  404 — page not found.
 *
 *  Uses the QuietScene illustration (cat asleep on a humming rack). The joke
 *  lands because the scene says "everything is fine" while the page you asked
 *  for is the one thing that isn't there.
 *
 *  This is where the QuietScene illustration now lives on the real site (the
 *  standalone /quiet concept page it came from has been deleted). It sits inside
 *  BaseLayout so the header and footer are present — someone who lands here by
 *  mistake needs a way back out.
 *
 *  Astro emits this as dist/404.html, which static hosts (Netlify, Vercel,
 *  Cloudflare Pages, nginx) serve automatically for unmatched routes.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import UptimeScene from '../components/UptimeScene.astro';
import { notFound } from '../data/site';
---

<BaseLayout title="Page not found" noindex>
  <section class="bg-cream py-12 lg:py-16">
    <Container>
      <div class="mx-auto flex max-w-xl flex-col items-center text-center">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-brand-700">
          {notFound.eyebrow}
        </p>
        <h1 class="mt-4 text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-tight text-navy-950">
          {notFound.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{notFound.body}</p>

        {/*
          UptimeScene, adopted here 2026-09-18. It is the right picture for a
          404: a storm outside, the lamp still lit, the cat asleep through it.
          Something went down and nothing else noticed — which is the whole
          message this page has to carry.

          It replaced QuietScene, which is still live on /our-mission and the
          contact success card. `surface="bare"` matches how QuietScene sat here;
          the panel would fight a page that is already a centred column.
        */}
        <UptimeScene
          chip={notFound.chip}
          caption={notFound.caption}
          surface="bare"
          class="mt-10 w-full max-w-sm"
        />

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href="/" chevron>Back to home</Button>
          <Button href="/contact" variant="secondary">Contact us</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
