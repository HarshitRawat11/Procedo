---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { Icon } from 'astro-icon/components';
import RackScene from '../components/RackScene.astro';
import { competencies, competenciesIntro } from '../data/site';
import { graph, breadcrumbs, services } from '../lib/schema';

/* The five competencies as Service nodes, each anchored to its own section.
   The Service nodes name the Organization as their provider by @id, and that
   @id now resolves inside this same document because BaseLayout emits the full
   Organization node on every page — which is why `organizationRef`, the stub
   that used to stand in for it here, is gone. */
const schema = graph(breadcrumbs([{ name: 'Services', path: '/services' }]), services());
---

<BaseLayout
  title="Services"
  description="Five core competencies — IT infrastructure, facilities security, AV, digital workplace and datacenter infrastructure — engineered as one system."
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  {/*
    RackScene in the header, adopted 2026-09-18. Services was the only page on
    the site with no artwork, and this scene had no page; Harshit paired them
    when he decided the home hero keeps its competency card.

    Bare at 20rem, matching /careers and /contact. RackScene's own chip and
    caption ("One U spare" / "Always leave room to grow.") live in site.ts as
    `rackBand` and are NOT passed here — the two header ornaments already live
    carry neither, and a third pattern would help nobody. Pass them if this ever
    wants the panel treatment instead.
  */}
  <PageHeader
    eyebrow={competenciesIntro.eyebrow}
    title={competenciesIntro.title}
    subtitle={competenciesIntro.sub}
  >
    <div slot="aside" class="mx-auto w-full max-w-[20rem] lg:ml-auto lg:mr-0">
      <RackScene id="services-header" />
    </div>
  </PageHeader>

  {
    competencies.map((c, idx) => (
      <section
        id={c.slug}
        class:list={[
          'scroll-mt-24 border-t border-line py-12 lg:py-16',
          idx % 2 === 1 ? 'bg-band' : 'bg-cream',
        ]}
      >
        <Container>
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-4" data-reveal>
              <span class="grid size-12 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                <Icon name={c.icon} class="size-6" aria-hidden="true" />
              </span>
              <h2 class="mt-5 text-2xl font-semibold text-navy-950 sm:text-3xl">{c.title}</h2>
              <p class="mt-2 font-medium text-brand-700">{c.tagline}</p>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">{c.intro}</p>
              {c.quote && (
                <blockquote class="mt-6 border-l-2 border-brand-500 pl-4 text-slate-600 italic">
                  “{c.quote}”
                </blockquote>
              )}
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
              {c.groups.map((g, gi) => (
                <div
                  data-reveal
                  style={`--reveal-delay:${(gi % 2) * 80}ms`}
                  class="rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-200 hover:border-slate-300 hover:shadow-lg hover:shadow-navy-950/[0.06]"
                >
                  <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">{g.name}</h3>
                  <ul class="mt-3 space-y-2 text-sm text-slate-600">
                    {g.items.map((it) => (
                      <li class="flex items-start gap-2">
                        <Icon
                          name="lucide:check"
                          class="mt-0.5 size-4 shrink-0 text-brand-500"
                          aria-hidden="true"
                        />
                        <span>{it}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </Container>
      </section>
    ))
  }

  <ClosingCta />
</BaseLayout>
