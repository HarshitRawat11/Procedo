---
/* ============================================================================
 *  /contact-preview — PREVIEW ONLY. Sealed off per CLAUDE.md §5: noindex, in no
 *  nav, linked from nowhere, excluded from the sitemap filter.
 *
 *  The live Contact page with ReceptionScene at the top of the left-hand
 *  column, above the direct channels: the cat at the front desk, answering the
 *  phone. Same bordered panel as /our-mission and /company-preview. Contact is
 *  the one content page with no artwork in its default state — QuietScene only
 *  appears after a successful send.
 *
 *  The two columns are top-aligned (lg:items-start) so the form card does not
 *  stretch, and the "What we can help with" chips sit under the form instead of
 *  under the channels, so the two columns run to similar heights.
 *
 *  Once approved: move ReceptionScene out of components/preview/, port the
 *  panel into contact.astro, then delete this page.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ReceptionScene from '../components/preview/ReceptionScene.astro';
import { Icon } from 'astro-icon/components';
import { contact, competencies, receptionBand } from '../data/site';

const telHref = 'tel:' + contact.phone.replace(/[^+\d]/g, '');

const channels = [
  {
    icon: 'lucide:mail',
    label: 'General enquiries',
    value: contact.email,
    href: `mailto:${contact.email}`,
  },
  {
    icon: 'lucide:briefcase',
    label: 'Sales',
    value: contact.salesEmail,
    href: `mailto:${contact.salesEmail}`,
  },
  { icon: 'lucide:phone', label: 'Phone', value: contact.phone, href: telHref },
];
---

<BaseLayout title="Contact — illustration preview" noindex>
  <div class="pv-banner">
    <Container>
      <p class="pv-banner-txt">
        <strong>Internal preview.</strong> The Contact page with the reception illustration above
        the direct channels. The phone rings and the cat picks up, once every twelve seconds. Not
        linked from the site, not indexed.
      </p>
    </Container>
  </div>

  <PageHeader
    eyebrow="Contact"
    title="Let’s talk about your systems"
    subtitle="Tell us what you’re planning — we’ll help you scope the right solution. No pressure, just expert guidance."
  />

  <section class="bg-cream py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <!-- The desk, then the direct channels -->
        <div data-reveal>
          <div class="rounded-2xl border border-line bg-band px-5 pt-7 pb-8">
            <ReceptionScene id="contact" chip={receptionBand.chip} caption={receptionBand.caption} />
          </div>

          <h2 class="mt-10 text-xl font-semibold text-navy-950">Reach us directly</h2>
          <div class="mt-6 space-y-4">
            {
              channels.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm transition-colors hover:border-brand-300"
                >
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name={c.icon} class="size-5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      {c.label}
                    </span>
                    <span class="block break-all font-medium text-navy-900">{c.value}</span>
                  </span>
                </a>
              ))
            }

            {
              contact.address && (
                <div class="flex items-start gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm">
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name="lucide:map-pin" class="size-5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      Office
                    </span>
                    <span class="block font-medium leading-relaxed text-navy-900">
                      {contact.address}
                    </span>
                  </span>
                </div>
              )
            }
          </div>
        </div>

        <!-- Form, with the service chips beneath it. The chips moved here from
             the left-hand column so the two columns run to similar heights once
             the illustration sits above the channels. -->
        <div data-reveal style="--reveal-delay:100ms">
          <div class="rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8">
            <h2 class="text-xl font-semibold text-navy-950">Send us a message</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              Share a few details and the right engineer will get back to you.
            </p>
            <div class="mt-7">
              <ContactForm />
            </div>
          </div>

          <!-- What we can help with -->
          <div class="mt-10 rounded-xl border border-line bg-band p-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">
              What we can help with
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {
                competencies.map((c) => (
                  <li>
                    <a
                      href={`/services#${c.slug}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1.5 text-sm text-navy-800 transition-colors hover:border-brand-300 hover:text-brand-700"
                    >
                      <Icon name={c.icon} class="size-3.5 text-brand-500" aria-hidden="true" />
                      {c.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .pv-banner {
    background: var(--color-navy-950);
    color: #fff;
    padding: 0.75rem 0;
  }
  .pv-banner-txt {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.78);
  }
  .pv-banner-txt strong {
    color: #fff;
    font-weight: 600;
  }
</style>
