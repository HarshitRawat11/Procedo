---
/*
 * HERO PREVIEW — un-parked on 2026-09-20 so the restructured hero can be seen
 * on the deployed Cloudflare preview, not just locally.
 *
 * This page is the REAL home page with ONE substitution: HeroIndex in place of
 * Hero. Everything below the fold is imported from the same components the
 * live page uses, so what differs between / and /hero-preview is exactly the
 * hero and nothing else. That is the point — it is a comparison, not a mock-up.
 *
 * It exists because CLAUDE.md rule 4 says to build previews as new pages rather
 * than editing live ones, and because the home hero is the page the client
 * signed off. Gate 4 (QUALITY-GATES.md) fails it on both distinctiveness
 * checks; this is the proposed answer, for Harshit and then Procedo to judge
 * before anything replaces the live hero.
 *
 * Per CLAUDE.md section 5 it is noindex, in no nav, linked from nowhere, and
 * already listed in the sitemap filter in astro.config.mjs.
 *
 * DELETE THIS PAGE once the hero question is settled either way - adopt
 * HeroIndex into components/home/ and remove this, or bin both.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Button from '../components/Button.astro';
import HeroIndex from '../components/preview/HeroIndex.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import { Icon } from 'astro-icon/components';
import { whyUs, mission, company } from '../data/site';
---
<BaseLayout title="Hero preview" headerOverlap noindex>
  <HeroIndex />
  <ServicesPreview />

  <!-- Who we are / mission teaser -->
  <section class="bg-cream py-12 lg:py-16">
    <Container>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6" data-reveal>
          <SectionHeading
            eyebrow="Who we are"
            title="An infrastructure-first technology firm"
            reveal={false}
          />
          <p class="mt-6 text-lg leading-relaxed text-ink-600">{company.overview[0]}</p>
          <p class="mt-4 leading-relaxed text-ink-600">{company.overview[1]}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button href="/company" chevron>Company Overview</Button>
            <Button href="/our-mission" variant="secondary">Our Mission</Button>
          </div>
        </div>

        <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
          <div class="rounded-2xl border border-line bg-white p-7 shadow-sm sm:p-9">
            <span
              class="grid size-11 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100"
            >
              <Icon name="lucide:quote" class="size-5" aria-hidden="true" />
            </span>
            <blockquote class="mt-6 text-lg font-medium leading-relaxed text-navy-900">
              {mission.statement}
            </blockquote>

            <div class="mt-7 border-t border-line pt-6">
              <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">
                {mission.purpose.listTitle}
              </h3>
              <ul class="mt-3.5 flex flex-wrap gap-2">
                {
                  mission.purpose.items.map((it) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-band px-3 py-1.5 text-sm text-navy-800">
                      <Icon
                        name="lucide:check"
                        class="size-3.5 shrink-0 text-brand-500"
                        aria-hidden="true"
                      />
                      {it}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Why partner with us -->
  <section class="border-t border-line bg-band py-12 lg:py-16">
    <Container>
      <SectionHeading
        eyebrow="Why Procedo"
        title="Why partner with Procedo?"
        subtitle="Experience the future of infrastructure-driven success with industry-leading expertise."
      />
      <FeatureGrid items={whyUs} columns={4} class="mt-12" />
    </Container>
  </section>

  <ClosingCta />
</BaseLayout>
