---
/* ============================================================================
 *  /services-preview — PREVIEW ONLY. Sealed off per CLAUDE.md §5: noindex, in no
 *  nav, linked from nowhere, named in the sitemap filter.
 *
 *  This is src/pages/services.astro with ONE difference: UptimeScene fills the
 *  PageHeader's `aside` slot, so the illustration is judged where it would
 *  actually live.
 *
 *  WHY HERE. Services is the only page on the site with no artwork at all, and
 *  it is the longest — five near-identical sections with nothing to break them
 *  up. It is also the page the picture argues for: the Datacenter Infrastructure
 *  section's own intro is "Uptime is engineered, not assumed", and a storm at
 *  3am with the lamp still lit is that sentence as a drawing.
 *
 *  TREATMENT: bare at 20rem, matching the header ornaments that went live on
 *  /careers and /contact on 2026-09-16. The first cut of this page used the
 *  panel treatment — bordered box, chip, caption — which was right when this was
 *  the only header illustration on the site and is wrong now that two live pages
 *  have set the other pattern. A page should not invent a third.
 *
 *  VERDICT, 2026-09-18: the header slot was right, the scene was not. Harshit
 *  moved UptimeScene to the 404 — where a storm with the lamp still on says
 *  exactly what a 404 needs to say — and gave this header to RackScene instead.
 *  Both of those are live now, so this page only duplicates /services with the
 *  wrong picture in it. Parked the same day.
 *
 *  Kept rather than deleted as the rehearsal space for the next change to that
 *  header. It has drifted from services.astro already; copy the live page in
 *  before trusting anything here.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { Icon } from 'astro-icon/components';
import UptimeScene from '../components/UptimeScene.astro';
import { competencies, competenciesIntro } from '../data/site';
import { graph, breadcrumbs, services, organizationRef } from '../lib/schema';

/* The five competencies as Service nodes, each anchored to its own section. */
const schema = graph(
  breadcrumbs([{ name: 'Services', path: '/services' }]),
  services(),
  organizationRef,
);
---

<BaseLayout
  noindex
  title="Services"
  description="Five core competencies — IT infrastructure, facilities security, AV & conferencing, digital workplace services, and datacenter infrastructure — engineered as one."
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />

  <PageHeader
    eyebrow={competenciesIntro.eyebrow}
    title={competenciesIntro.title}
    subtitle={competenciesIntro.sub}
  >
    <div slot="aside" class="mx-auto w-full max-w-[20rem] lg:ml-auto lg:mr-0">
      <UptimeScene chip="" caption="" surface="bare" />
    </div>
  </PageHeader>

  {
    competencies.map((c, idx) => (
      <section
        id={c.slug}
        class:list={[
          'scroll-mt-24 border-t border-line py-12 lg:py-16',
          idx % 2 === 1 ? 'bg-band' : 'bg-cream',
        ]}
      >
        <Container>
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-4" data-reveal>
              <span class="grid size-12 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                <Icon name={c.icon} class="size-6" aria-hidden="true" />
              </span>
              <h2 class="mt-5 text-2xl font-semibold text-navy-950 sm:text-3xl">{c.title}</h2>
              <p class="mt-2 font-medium text-brand-700">{c.tagline}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-600">{c.intro}</p>
              {c.quote && (
                <blockquote class="mt-6 border-l-2 border-brand-500 pl-4 text-ink-600 italic">
                  “{c.quote}”
                </blockquote>
              )}
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
              {c.groups.map((g, gi) => (
                <div
                  data-reveal
                  style={`--reveal-delay:${(gi % 2) * 80}ms`}
                  class="rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-200 hover:border-ink-300 hover:shadow-lg hover:shadow-navy-950/[0.06]"
                >
                  <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">{g.name}</h3>
                  <ul class="mt-3 space-y-2 text-sm text-ink-600">
                    {g.items.map((it) => (
                      <li class="flex items-start gap-2">
                        <Icon
                          name="lucide:check"
                          class="mt-0.5 size-4 shrink-0 text-brand-500"
                          aria-hidden="true"
                        />
                        <span>{it}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </Container>
      </section>
    ))
  }

  <ClosingCta />
</BaseLayout>
