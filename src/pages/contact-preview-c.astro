---
/* ============================================================================
 *  /contact-preview-c — PREVIEW ONLY (option C). Sealed off per CLAUDE.md §5:
 *  noindex, in no nav, linked from nowhere, excluded from the sitemap filter.
 *
 *  Harshit's idea: the live Contact page exactly as it is, and a small crop of
 *  the reception scene — the cat, the phone, the handset — tucked into the
 *  empty space beside the form's Send button. Nothing else on the page moves.
 *
 *  Mechanics: ReceptionScene's `vignette` variant crops the same SVG (same
 *  animation, same twelve-second loop) to 248 x 90 units, and ContactForm's new
 *  `aside` slot pins it to the form's bottom-right, hidden below the sm
 *  breakpoint. Because it is a child of the form it disappears with the form on
 *  a successful send, so the "Message received" cat never shares the card with
 *  it; the rule below hides it whenever the form shows a status message, so it
 *  never sits over an error.
 *
 *  Options A (illustration under the header) and B (closing the page beside
 *  the office address) are at /contact-preview and /contact-preview-b.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ReceptionScene from '../components/preview/ReceptionScene.astro';
import { Icon } from 'astro-icon/components';
import { contact, competencies, contactStatement } from '../data/site';

const telHref = 'tel:' + contact.phone.replace(/[^+\d]/g, '');

const channels = [
  {
    icon: 'lucide:mail',
    label: 'General enquiries',
    value: contact.email,
    href: `mailto:${contact.email}`,
  },
  {
    icon: 'lucide:briefcase',
    label: 'Sales',
    value: contact.salesEmail,
    href: `mailto:${contact.salesEmail}`,
  },
  { icon: 'lucide:phone', label: 'Phone', value: contact.phone, href: telHref },
];
---

<BaseLayout title="Contact — illustration preview C" noindex>
  <div class="pv-banner">
    <Container>
      <p class="pv-banner-txt">
        <strong>Internal preview — option C.</strong> The live page as it is, with a small crop of
        the cat picking up the phone beside the form's Send button. Option A (under the header) is
        at <a href="/contact-preview">/contact-preview</a>, option B (closing the page beside the
        office address) at <a href="/contact-preview-b">/contact-preview-b</a>. Not linked from the
        site, not indexed.
      </p>
    </Container>
  </div>

  <PageHeader eyebrow="Contact" title="Let’s talk about your systems" subtitle={contactStatement} />

  <section class="bg-cream py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Direct channels, as on the live page -->
        <div data-reveal>
          <h2 class="text-xl font-semibold text-navy-950">Reach us directly</h2>
          <div class="mt-6 space-y-4">
            {
              channels.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm transition-colors hover:border-brand-300"
                >
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name={c.icon} class="size-5" aria-hidden="true" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      {c.label}
                    </span>
                    <span class="block break-all font-medium text-navy-900">{c.value}</span>
                  </span>
                </a>
              ))
            }

            {
              contact.address && (
                <div class="flex items-start gap-3.5 rounded-xl border border-line bg-white p-4 shadow-sm">
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                    <Icon name="lucide:map-pin" class="size-5" aria-hidden="true" />
                  </span>
                  <span>
                    <span class="block text-xs font-medium uppercase tracking-wider text-slate-500">
                      Office
                    </span>
                    <span class="block font-medium leading-relaxed text-navy-900">
                      {contact.address}
                    </span>
                  </span>
                </div>
              )
            }
          </div>

          <!-- What we can help with -->
          <div class="mt-10 rounded-xl border border-line bg-band p-6">
            <h3 class="font-mono text-xs uppercase tracking-wider text-navy-700">
              What we can help with
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-2">
              {
                competencies.map((c) => (
                  <li>
                    <a
                      href={`/services#${c.slug}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1.5 text-sm text-navy-800 transition-colors hover:border-brand-300 hover:text-brand-700"
                    >
                      <Icon name={c.icon} class="size-3.5 text-brand-500" aria-hidden="true" />
                      {c.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Form, with the cat beside the Send button -->
        <div
          data-reveal
          style="--reveal-delay:100ms"
          class="form-card rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8"
        >
          <h2 class="text-xl font-semibold text-navy-950">Send us a message</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Share a few details and the right engineer will get back to you.
          </p>
          <div class="mt-7">
            <ContactForm>
              <ReceptionScene slot="aside" variant="vignette" id="contact-form" />
            </ContactForm>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .pv-banner {
    background: var(--color-navy-950);
    color: #fff;
    padding: 0.75rem 0;
  }
  .pv-banner-txt {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.78);
  }
  .pv-banner-txt strong {
    color: #fff;
    font-weight: 600;
  }
  .pv-banner-txt a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The cat steps aside whenever the form has something to say. */
  .form-card :global(form:has(#cf-status:not([hidden])) .cf-aside) {
    display: none;
  }
</style>
