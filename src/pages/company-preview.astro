---
/* ============================================================================
 *  /company-preview — PREVIEW ONLY. Sealed off per CLAUDE.md §5: noindex, in no
 *  nav, linked from nowhere, excluded from the sitemap filter.
 *
 *  The Company page with WorkshopScene filling the empty right-hand side of the
 *  page header, beside "Company Overview". Everything else is a faithful copy
 *  of src/pages/company.astro.
 *
 *  Revised 2026-09-09: it was previously a band between "Core values" and
 *  "Why us". Harshit did not like that location and pointed at the header's
 *  negative space instead. `PageHeader` gained an optional `aside` slot for
 *  this; the four other pages that use it pass nothing and are unaffected.
 *
 *  No caption here. A caption under a page-header illustration reads as a
 *  strapline rather than a remark, and the header already has a subtitle doing
 *  that job. The empty hook has to carry the joke on its own.
 *
 *  Once approved: move WorkshopScene out of components/preview/ into
 *  components/, add the slot to company.astro, then delete this page.
 * ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ClosingCta from '../components/ClosingCta.astro';
import WorkshopScene from '../components/preview/WorkshopScene.astro';
import { Icon } from 'astro-icon/components';
import { company, whyUs, competencies } from '../data/site';
---

<BaseLayout title="Company — illustration preview" noindex>
  <div class="pv-banner">
    <Container>
      <p class="pv-banner-txt">
        <strong>Internal preview.</strong> The Company page with the workshop illustration filling
        the header’s empty right-hand side. Not linked from the site, not indexed.
      </p>
    </Container>
  </div>

  <!-- The illustration now fills the header's empty right-hand side rather than
       sitting in a band further down. `aside` is an optional slot, so the other
       four pages that use PageHeader are untouched. -->
  <PageHeader
    eyebrow="Company"
    title="Company Overview"
    subtitle="An infrastructure-first technology firm — bringing IT, security, AV, digital workplace and datacenter infrastructure together into systems that quietly work."
  >
    <WorkshopScene slot="aside" id="header" class="mx-auto max-w-md lg:max-w-none" />
  </PageHeader>

  <!-- Overview -->
  <section class="bg-cream py-16 lg:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-3xl space-y-6 lg:col-span-7" data-reveal>
          {
            company.overview.map((p) => (
              <p class="text-lg leading-relaxed text-slate-600">{p}</p>
            ))
          }
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:120ms">
          <div
            class="overflow-hidden rounded-xl border border-line bg-white shadow-sm shadow-navy-950/[0.04]"
          >
            <p
              class="border-b border-line px-6 py-4 font-mono text-xs uppercase tracking-[0.18em] text-navy-600"
            >
              What we deliver
            </p>
            <ul>
              {
                competencies.map((c, i) => (
                  <li class={i > 0 ? 'border-t border-line' : ''}>
                    <a
                      href={`/services#${c.slug}`}
                      class="group flex items-center gap-4 px-6 py-4 transition-colors hover:bg-band"
                    >
                      <span class="grid size-9 shrink-0 place-items-center rounded-md bg-brand-50 text-brand-600 ring-1 ring-brand-100">
                        <Icon name={c.icon} class="size-[18px]" aria-hidden="true" />
                      </span>
                      <span class="min-w-0 flex-1 text-sm font-medium text-navy-900">{c.title}</span>
                      <Icon
                        name="lucide:arrow-up-right"
                        class="size-4 text-slate-400 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Core values -->
  <section id="values" class="scroll-mt-24 border-t border-line bg-band py-16 lg:py-24">
    <Container>
      <SectionHeading
        eyebrow="Our core values"
        title="What we stand for"
        subtitle={company.valuesIntro}
      />
      <FeatureGrid items={company.values} columns={3} class="mt-12" />
    </Container>
  </section>

  <!-- Why us -->
  <section id="why-us" class="scroll-mt-24 border-t border-line bg-cream py-16 lg:py-24">
    <Container>
      <SectionHeading
        eyebrow="Why us?"
        title="Why partner with Procedo?"
        subtitle="Experience the future of infrastructure-driven success with industry-leading expertise."
      />
      <FeatureGrid items={whyUs} columns={4} class="mt-12" />
    </Container>
  </section>

  <ClosingCta />
</BaseLayout>

<style>
  .pv-banner {
    background: var(--color-navy-950);
    color: #fff;
    padding: 0.75rem 0;
  }
  .pv-banner-txt {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.78);
  }
  .pv-banner-txt strong {
    color: #fff;
    font-weight: 600;
  }
  .pv-tag {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-600);
  }
</style>
