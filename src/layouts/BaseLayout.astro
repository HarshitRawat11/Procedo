---
// Primary site layout: SEO <head>, skip link, sticky header, footer, and the
// shared scroll-reveal observer. Per-page structured data (JSON-LD) can be
// injected via the named "head" slot (added per page in Phase 4).
import '@fontsource-variable/inter'; // single sans for all type (GitHub-style)
import '@fontsource/ibm-plex-mono/400.css'; // mono — small eyebrow labels only
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { graph, organization, website } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** When true, content sits under the translucent header (used by the home hero). */
  headerOverlap?: boolean;
}
const {
  title,
  description = site.description,
  image = '/og-default.png',
  noindex = false,
  headerOverlap = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title ? `${title} | ${site.name}` : site.homeTitle;

/*
 * Organization + WebSite on EVERY page, not just the home page.
 *
 * It used to be emitted from index.astro alone, and the inner pages carried a
 * BreadcrumbList and nothing else — so a crawler arriving on /contact or
 * /services straight from a search result (which is how most of them arrive)
 * got no address, no phone, no service area and no logo. Those pages referred
 * to the Organization by @id across documents, and Google resolves a
 * cross-document @id unreliably at best.
 *
 * Pages still add their own graph in the `head` slot for what is specific to
 * them — the breadcrumb trail, and the Service list on /services. Two ld+json
 * blocks on one page is valid and is how most sites do this.
 *
 * Skipped on noindex pages: the 404 has nothing to say to an index.
 */
const baseSchema = noindex ? null : graph(organization, website);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#FBFAF8" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.png" type="image/png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* LinkedIn and Facebook render the card immediately when the dimensions are
        declared; without them they queue a fetch and often show no image on the
        first share. og-default.png is 1200x630, the size both expect. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.legalName} — ${site.tagline}`} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.legalName} — ${site.tagline}`} />

    {/* Organization + WebSite, on every indexable page. See the note above. */}
    {baseSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(baseSchema)} />
    )}

    <slot name="head" />

    <Analytics />

    {/*
      Client-side routing, so navigation cross-fades instead of flashing white.
      About 10 kB of JS — the only runtime cost on the site beyond the three
      small scripts below.

      It swaps <body>, so anything holding a reference to an element must
      re-bind on `astro:page-load`. Three scripts do: the reveal observer
      below, Header, and ContactForm. ContactForm is the one that matters —
      its module would otherwise execute only once, and a second visit to
      /contact in the same session would leave the form unbound, native-POST
      to Web3Forms and take the visitor off the site instead of showing the
      success card.
    */}
    <ClientRouter />

    <!-- Enable scroll-reveal only when motion is allowed AND it's supported.
         Runs synchronously before paint so content never flashes hidden.

         `astro:after-swap` re-applies it, and that listener is NOT optional.
         The ClientRouter copies the incoming document's <html> attributes over
         the live ones, and the incoming document is static HTML with no class
         at all — so every client-side navigation stripped `reveal` off the root
         and the hidden state stopped applying. The effect was that only the
         page you LANDED on animated; everything you reached by clicking a nav
         link just appeared, including coming back to a page that had animated
         a minute earlier. after-swap runs before the browser paints, so the
         class is back in time and nothing flashes.

         This script is inline and in <head> on purpose: it has to run before
         first paint. The listener is idempotent — re-running this script only
         re-adds a class that is already there. -->
    <script is:inline>
      (() => {
        const wanted =
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          'IntersectionObserver' in window;
        if (!wanted) return;
        const apply = () => document.documentElement.classList.add('reveal');
        apply();
        if (!window.__revealRootBound) {
          window.__revealRootBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
  </head>
  <body class="bg-cream antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class:list={[!headerOverlap && 'pt-16 lg:pt-[4.5rem]']}>
      <slot />
    </main>

    <Footer />

    <script>
      // Add `.is-visible` as elements enter the viewport. Only runs when the
      // `.reveal` class is present (set by the inline head script above);
      // otherwise content is already visible, so there is nothing to do.
      //
      // One observer for the life of the tab; `scan()` re-runs after every
      // client-side navigation, since the router replaces the elements.
      if (document.documentElement.classList.contains('reveal')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        const scan = () =>
          document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => io.observe(el));
        scan();
        document.addEventListener('astro:page-load', scan);
      }
    </script>
  </body>
</html>
