# build output
dist/
dist-client/
.output/

# dependencies
node_modules/

# astro generated types & cache
.astro/

# environment & secrets
.env
.env.production
.env.local

# os / editor
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# local scrape + downloaded reference assets (not part of the app)
scrape/
reference/*
# ...but the written procedures at the top level of reference/ are project
# knowledge, not downloaded assets. Track them.
!reference/*.md

# ...but DO track the written design analysis. The reference images stay local
# (they are third-party screenshots), while the notes derived from them are real
# project knowledge and should survive a machine change.
!reference/inspiration/
reference/inspiration/*
!reference/inspiration/*.md

# verification artifacts
lighthouse*.json

# Design-audit screenshots and their derivatives (QUALITY-GATES.md evidence).
# Regenerable output, like dist/ — about 21 MB per full run, which would more
# than quadruple this repo permanently. The SCRIPTS that produce it are tracked
# in scripts/, so anyone can rebuild the evidence:
#
#   npm run build
#   node scripts/serve-dist.cjs --no-headers &
#   node scripts/shoot-screens.cjs
#   node scripts/measure-hierarchy.cjs
review/

# host CLI scratch state, not project config. `netlify deploy` writes
# .netlify/ (a copy of netlify.toml plus a site-id cache) and `wrangler`
# writes .wrangler/. Both are local to one machine and one login.
.netlify/
.wrangler/
